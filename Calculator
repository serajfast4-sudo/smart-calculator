<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0f172a">
    <title>Full Mobile Calculator</title>

    <link rel="manifest" href='data:application/manifest+json,{
        "name": "Full Calculator",
        "short_name": "Calc",
        "start_url": ".",
        "display": "standalone",
        "background_color": "#0f172a",
        "theme_color": "#0f172a",
        "icons": [{
            "src": "https://via.placeholder.com/512.png?text=Calc",
            "sizes": "512x512",
            "type": "image/png"
        }]
    }'>

    <style>
        :root {
            --bg1: #1e1b4b;
            --bg2: #0f172a;
            --bg3: #164e63;
            --glass: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.16);
            --op: rgba(37, 99, 235, 0.55);
            --sci: rgba(56, 189, 248, 0.12);
            --action: rgba(220, 38, 38, 0.55);
            --eq: rgba(22, 163, 74, 0.6);
            --text: #f8fafc;
            --muted: #94a3b8;
            --accent: #7dd3fc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background:
                radial-gradient(circle at 15% 20%, rgba(99, 102, 241, 0.35), transparent 45%),
                radial-gradient(circle at 85% 15%, rgba(56, 189, 248, 0.3), transparent 40%),
                radial-gradient(circle at 50% 90%, rgba(20, 184, 166, 0.25), transparent 45%),
                linear-gradient(160deg, var(--bg1), var(--bg2) 60%, var(--bg3));
            background-attachment: fixed;
            color: var(--text);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .calc-app {
            width: 100vw;
            height: 100vh;
            max-width: 480px;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 30px;
        }

        .hist-toggle {
            background: var(--glass);
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border: 1px solid var(--glass-border);
            color: var(--muted);
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
            cursor: pointer;
        }

        .screen {
            background: rgba(2, 6, 23, 0.5);
            backdrop-filter: blur(24px) saturate(160%);
            -webkit-backdrop-filter: blur(24px) saturate(160%);
            border-radius: 20px;
            padding: 16px;
            border: 1px solid var(--glass-border);
            box-shadow: 0 10px 30px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.1);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            height: 120px;
        }

        .expr {
            color: var(--muted);
            font-size: 1rem;
            text-align: right;
            min-height: 1.2rem;
        }

        .output {
            color: var(--text);
            font-size: 2.4rem;
            font-weight: bold;
            text-align: right;
            overflow-x: auto;
            white-space: nowrap;
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            flex: 1;
        }

        button {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--glass-border);
            outline: none;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 14px;
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            touch-action: manipulation;
            backdrop-filter: blur(18px) saturate(180%);
            -webkit-backdrop-filter: blur(18px) saturate(180%);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.25), 0 6px 14px rgba(0,0,0,0.25);
        }

        button::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 55%;
            background: linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0) 100%);
            pointer-events: none;
        }

        button:active {
            transform: scale(0.96);
            filter: brightness(0.88);
        }

        .b-num { background-color: var(--glass); }
        .b-op { background-color: var(--op); }
        .b-sci { background-color: var(--sci); color: var(--accent); font-size: 0.95rem; }
        .b-clear { background-color: var(--action); }
        .b-eq { background-color: var(--eq); grid-column: span 2; }

        .drawer {
            position: fixed;
            top: 0; right: -100%;
            width: 80%; max-width: 320px; height: 100%;
            background: rgba(15, 23, 42, 0.55);
            backdrop-filter: blur(30px) saturate(180%);
            -webkit-backdrop-filter: blur(30px) saturate(180%);
            border-left: 1px solid var(--glass-border);
            box-shadow: -10px 0 30px rgba(0,0,0,0.45);
            transition: right 0.3s ease;
            z-index: 10;
            padding: 20px;
            display: flex;
            flex-direction: column;
        }

        .drawer.open { right: 0; }
        .drawer-list { list-style: none; overflow-y: auto; flex: 1; margin: 15px 0; }
        .drawer-item {
            padding: 10px;
            background: rgba(2, 6, 23, 0.4);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>

<div class="calc-app">
    <div class="top-bar">
        <button class="hist-toggle" onclick="toggleDrawer()">🕒 History</button>
    </div>

    <div class="screen">
        <div class="expr" id="expr"></div>
        <div class="output" id="out">0</div>
    </div>

    <div class="keypad">
        <button class="b-sci" onclick="addFn('sin')">sin</button>
        <button class="b-sci" onclick="addFn('cos')">cos</button>
        <button class="b-sci" onclick="addFn('tan')">tan</button>
        <button class="b-clear" onclick="clearAll()">AC</button>
        <button class="b-clear" onclick="del()">DEL</button>

        <button class="b-sci" onclick="addFn('asin')">asin</button>
        <button class="b-sci" onclick="addFn('acos')">acos</button>
        <button class="b-sci" onclick="addFn('atan')">atan</button>
        <button class="b-sci" onclick="add('(')">(</button>
        <button class="b-sci" onclick="add(')')">)</button>

        <button class="b-sci" onclick="addFn('log')">log</button>
        <button class="b-sci" onclick="addFn('ln')">ln</button>
        <button class="b-sci" onclick="addFn('sqrt')">√</button>
        <button class="b-sci" onclick="add('^')">x^y</button>
        <button class="b-op" onclick="add('/')">÷</button>

        <button class="b-num" onclick="add('7')">7</button>
        <button class="b-num" onclick="add('8')">8</button>
        <button class="b-num" onclick="add('9')">9</button>
        <button class="b-sci" onclick="add('%')">%</button>
        <button class="b-op" onclick="add('*')">×</button>

        <button class="b-num" onclick="add('4')">4</button>
        <button class="b-num" onclick="add('5')">5</button>
        <button class="b-num" onclick="add('6')">6</button>
        <button class="b-sci" onclick="addConst('pi')">π</button>
        <button class="b-op" onclick="add('-')">-</button>

        <button class="b-num" onclick="add('1')">1</button>
        <button class="b-num" onclick="add('2')">2</button>
        <button class="b-num" onclick="add('3')">3</button>
        <button class="b-sci" onclick="addConst('e')">e</button>
        <button class="b-op" onclick="add('+')">+</button>

        <button class="b-num" onclick="add('0')">0</button>
        <button class="b-num" onclick="add('.')">.</button>
        <button class="b-sci" onclick="add('!')">x!</button>
        <button class="b-eq" onclick="calc()">=</button>
    </div>
</div>

<div class="drawer" id="drawer">
    <div style="display:flex; justify-content:space-between;">
        <span style="color:var(--accent); font-weight:bold;">History</span>
        <button onclick="clearHist()" style="background:none; color:var(--action);">Clear</button>
    </div>
    <ul class="drawer-list" id="hist-list"></ul>
    <button style="background:var(--num); padding:10px;" onclick="toggleDrawer()">Close</button>
</div>

<script>
    let current = '', exprText = '', reset = false;

    const outEl = document.getElementById('out');
    const exprEl = document.getElementById('expr');
    const histEl = document.getElementById('hist-list');

    function toggleDrawer() { document.getElementById('drawer').classList.toggle('open'); }

    function add(val) {
        if (reset) { current = ''; reset = false; }
        current += val;
        render();
    }

    function addFn(fn) {
        if (reset) reset = false;
        current += fn + '(';
        render();
    }

    function addConst(c) {
        if (reset) { current = ''; reset = false; }
        current += c === 'pi' ? 'Math.PI' : 'Math.E';
        render();
    }

    function clearAll() { current = ''; exprText = ''; render(); }
    function del() { if (!reset) { current = current.slice(0, -1); render(); } }

    function render() {
        outEl.textContent = current
            .replace(/Math\.PI/g, 'π')
            .replace(/Math\.E/g, 'e')
            .replace(/\*/g, '×')
            .replace(/\//g, '÷') || '0';
        exprEl.textContent = exprText;
    }

    function factorial(n) {
        if (n < 0) return NaN;
        if (n <= 1) return 1;
        let r = 1; for (let i = 2; i <= n; i++) r *= i;
        return r;
    }

    function parseMath(str) {
        let p = str
            .replace(/sin\(/g, 'Math.sin(')
            .replace(/cos\(/g, 'Math.cos(')
            .replace(/tan\(/g, 'Math.tan(')
            .replace(/asin\(/g, 'Math.asin(')
            .replace(/acos\(/g, 'Math.acos(')
            .replace(/atan\(/g, 'Math.atan(')
            .replace(/log\(/g, 'Math.log10(')
            .replace(/ln\(/g, 'Math.log(')
            .replace(/sqrt\(/g, 'Math.sqrt(')
            .replace(/\^/g, '**')
            .replace(/(\d+)%/g, '($1/100)');
        return p.replace(/(\d+)!/g, (_, n) => factorial(parseInt(n)));
    }

    function calc() {
        if (!current) return;
        try {
            exprText = current.replace(/Math\.PI/g, 'π').replace(/Math\.E/g, 'e');
            let res = eval(parseMath(current));
            if (typeof res === 'number' && !isNaN(res)) {
                res = Number(res.toFixed(8));
                saveHist(exprText, res);
                current = res.toString();
                outEl.textContent = res;
                exprEl.textContent = exprText + ' =';
                reset = true;
            } else { outEl.textContent = 'Error'; }
        } catch { outEl.textContent = 'Error'; }
    }

    function saveHist(e, v) {
        const li = document.createElement('li');
        li.className = 'drawer-item';
        li.innerHTML = `<div style="color:var(--muted); font-size:0.8rem;">${e}</div><div style="color:var(--accent); font-weight:bold;">${v}</div>`;
        li.onclick = () => { current = v.toString(); reset = false; render(); toggleDrawer(); };
        histEl.prepend(li);
    }

    function clearHist() { histEl.innerHTML = ''; }
</script>
</body>
</html>
