const physicsData={
    Mechanics:[
        {name:"Newton's 2nd Law",eq:"F=ma",vars:[{id:'F',label:'Force (F)',unit:'N'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'a',label:'Acceleration (a)',unit:'m/s²'}],solve:{F:({m,a})=>m*a,m:({F,a})=>F/a,a:({F,m})=>F/m}},
        {name:"Velocity (SUVAT)",eq:"v=u+at",vars:[{id:'v',label:'Final vel (v)',unit:'m/s'},{id:'u',label:'Initial vel (u)',unit:'m/s'},{id:'a',label:'Acceleration (a)',unit:'m/s²'},{id:'t',label:'Time (t)',unit:'s'}],solve:{v:({u,a,t})=>u+a*t,u:({v,a,t})=>v-a*t,a:({v,u,t})=>(v-u)/t,t:({v,u,a})=>(v-u)/a}},
        {name:"Displacement (SUVAT)",eq:"s=ut+½at²",vars:[{id:'s',label:'Displacement (s)',unit:'m'},{id:'u',label:'Initial vel (u)',unit:'m/s'},{id:'a',label:'Accel (a)',unit:'m/s²'},{id:'t',label:'Time (t)',unit:'s'}],solve:{s:({u,a,t})=>u*t+0.5*a*t*t,u:({s,a,t})=>(s-0.5*a*t*t)/t,a:({s,u,t})=>2*(s-u*t)/(t*t),t:({s,u,a})=>(-u+Math.sqrt(u*u+2*a*s))/a}},
        {name:"Momentum",eq:"p=mv",vars:[{id:'p',label:'Momentum (p)',unit:'kg·m/s'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'v',label:'Velocity (v)',unit:'m/s'}],solve:{p:({m,v})=>m*v,m:({p,v})=>p/v,v:({p,m})=>p/m}},
        {name:"Work Done",eq:"W=Fd",vars:[{id:'W',label:'Work (W)',unit:'J'},{id:'F',label:'Force (F)',unit:'N'},{id:'d',label:'Distance (d)',unit:'m'}],solve:{W:({F,d})=>F*d,F:({W,d})=>W/d,d:({W,F})=>W/F}},
        {name:"Power",eq:"P=W/t",vars:[{id:'P',label:'Power (P)',unit:'W'},{id:'W',label:'Work (W)',unit:'J'},{id:'t',label:'Time (t)',unit:'s'}],solve:{P:({W,t})=>W/t,W:({P,t})=>P*t,t:({W,P})=>W/P}},
    ],
    Energy:[
        {name:"Kinetic Energy",eq:"KE=½mv²",vars:[{id:'KE',label:'Kinetic E',unit:'J'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'v',label:'Velocity (v)',unit:'m/s'}],solve:{KE:({m,v})=>0.5*m*v*v,m:({KE,v})=>2*KE/(v*v),v:({KE,m})=>Math.sqrt(2*KE/m)}},
        {name:"Potential Energy",eq:"PE=mgh",vars:[{id:'PE',label:'Potential E',unit:'J'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'g',label:'Gravity (g)',unit:'m/s²'},{id:'h',label:'Height (h)',unit:'m'}],solve:{PE:({m,g,h})=>m*g*h,m:({PE,g,h})=>PE/(g*h),g:({PE,m,h})=>PE/(m*h),h:({PE,m,g})=>PE/(m*g)}},
        {name:"Efficiency",eq:"η=(Wout/Win)×100",vars:[{id:'n',label:'Efficiency (η)',unit:'%'},{id:'Wout',label:'Useful output',unit:'J'},{id:'Win',label:'Total input',unit:'J'}],solve:{n:({Wout,Win})=>Wout/Win*100,Wout:({n,Win})=>n/100*Win,Win:({n,Wout})=>Wout/(n/100)}},
    ],
    Waves:[
        {name:"Wave Speed",eq:"v=fλ",vars:[{id:'v',label:'Speed (v)',unit:'m/s'},{id:'f',label:'Frequency (f)',unit:'Hz'},{id:'l',label:'Wavelength (λ)',unit:'m'}],solve:{v:({f,l})=>f*l,f:({v,l})=>v/l,l:({v,f})=>v/f}},
        {name:"Period",eq:"T=1/f",vars:[{id:'T',label:'Period (T)',unit:'s'},{id:'f',label:'Frequency (f)',unit:'Hz'}],solve:{T:({f})=>1/f,f:({T})=>1/T}},
    ],
    Electric:[
        {name:"Ohm's Law",eq:"V=IR",vars:[{id:'V',label:'Voltage (V)',unit:'V'},{id:'I',label:'Current (I)',unit:'A'},{id:'R',label:'Resistance (R)',unit:'Ω'}],solve:{V:({I,R})=>I*R,I:({V,R})=>V/R,R:({V,I})=>V/I}},
        {name:"Electric Power",eq:"P=VI",vars:[{id:'P',label:'Power (P)',unit:'W'},{id:'V',label:'Voltage (V)',unit:'V'},{id:'I',label:'Current (I)',unit:'A'}],solve:{P:({V,I})=>V*I,V:({P,I})=>P/I,I:({P,V})=>P/V}},
        {name:"Electric Charge",eq:"Q=It",vars:[{id:'Q',label:'Charge (Q)',unit:'C'},{id:'I',label:'Current (I)',unit:'A'},{id:'t',label:'Time (t)',unit:'s'}],solve:{Q:({I,t})=>I*t,I:({Q,t})=>Q/t,t:({Q,I})=>Q/I}},
    ],
    Thermo:[
        {name:"Ideal Gas Law",eq:"PV=nRT",vars:[{id:'P',label:'Pressure (P)',unit:'Pa'},{id:'V',label:'Volume (V)',unit:'m³'},{id:'n',label:'Moles (n)',unit:'mol'},{id:'T',label:'Temp (T)',unit:'K'}],solve:{P:({V,n,T})=>n*8.314*T/V,V:({P,n,T})=>n*8.314*T/P,n:({P,V,T})=>P*V/(8.314*T),T:({P,V,n})=>P*V/(n*8.314)}},
        {name:"Heat Transfer",eq:"Q=mcΔT",vars:[{id:'Q',label:'Heat (Q)',unit:'J'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'c',label:'Specific heat',unit:'J/kg·K'},{id:'dT',label:'ΔT',unit:'K'}],solve:{Q:({m,c,dT})=>m*c*dT,m:({Q,c,dT})=>Q/(c*dT),c:({Q,m,dT})=>Q/(m*dT),dT:({Q,m,c})=>Q/(m*c)}},
    ],
};
let phyCat='Mechanics';
function initPhysics(){const bar=document.getElementById('phy-cat-bar');Object.keys(physicsData).forEach(cat=>{const b=document.createElement('button');b.className='phy-cat-btn'+(cat===phyCat?' active':'');b.textContent=cat;b.onclick=()=>{tap();selectPhyCat(cat);};bar.appendChild(b);});renderPhyFormulas();}
function selectPhyCat(cat){phyCat=cat;document.querySelectorAll('.phy-cat-btn').forEach(b=>b.classList.toggle('active',b.textContent===cat));renderPhyFormulas();}
function renderPhyFormulas(){const list=document.getElementById('phy-formula-list');list.innerHTML='';physicsData[phyCat].forEach((formula,fi)=>{const card=document.createElement('div');card.className='phy-formula-card';card.innerHTML=`<div class="phy-formula-header" onclick="togglePhyCard(${fi})"><span class="phy-formula-name">${formula.name}</span><span class="phy-formula-eq">${formula.eq}</span></div><div class="phy-formula-body" id="phy-body-${fi}">${formula.vars.map(v=>`<div class="phy-var-row"><label class="phy-var-label">${v.label}</label><input class="phy-var-input" id="phy-${fi}-${v.id}" type="number" placeholder="?" /><span class="phy-var-unit">${v.unit}</span></div>`).join('')}<button class="phy-solve-btn" onclick="solvePhysics(${fi})">Solve missing variable</button><div class="phy-result" id="phy-result-${fi}"></div></div>`;list.appendChild(card);});}
function togglePhyCard(fi){tap();const body=document.getElementById('phy-body-'+fi);const isOpen=body.classList.contains('open');document.querySelectorAll('.phy-formula-body').forEach(b=>b.classList.remove('open'));if(!isOpen)body.classList.add('open');}
function solvePhysics(fi){tap();const formula=physicsData[phyCat][fi];const vals={};let missing=null,multiMissing=false;formula.vars.forEach(v=>{const val=parseFloat(document.getElementById(`phy-${fi}-${v.id}`).value);if(isNaN(val)){if(missing)multiMissing=true;else missing=v;}else vals[v.id]=val;});const resultEl=document.getElementById(`phy-result-${fi}`);resultEl.style.display='block';if(!missing){resultEl.textContent='⚠ Leave one field empty to solve for it';return;}if(multiMissing){resultEl.textContent='⚠ Fill all but one field';return;}if(!formula.solve[missing.id]){resultEl.textContent='⚠ Cannot solve for this variable directly';return;}try{const res=formula.solve[missing.id](vals);if(isNaN(res)||!isFinite(res)){resultEl.textContent='⚠ Invalid values';return;}const rounded=parseFloat(res.toFixed(6));resultEl.textContent=`${missing.label.split('(')[0].trim()} = ${rounded} ${missing.unit}`;document.getElementById(`phy-${fi}-${missing.id}`).value=rounded;}catch{resultEl.textContent='⚠ Cannot solve with these values';}}

