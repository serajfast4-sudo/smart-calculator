        {name:"Momentum",eq:"p=mv",vars:[{id:'p',label:'Momentum (p)',unit:'kg·m/s'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'v',label:'Velocity (v)',unit:'m/s'}],solve:{p:({m,v})=>m*v,m:({p,v})=>p/v,v:({p,m})=>p/m}},
        {name:"Work Done",eq:"W=Fd",vars:[{id:'W',label:'Work (W)',unit:'J'},{id:'F',label:'Force (F)',unit:'N'},{id:'d',label:'Distance (d)',unit:'m'}],solve:{W:({F,d})=>F*d,F:({W,d})=>W/d,d:({W,F})=>W/F}},
        {name:"Power",eq:"P=W/t",vars:[{id:'P',label:'Power (P)',unit:'W'},{id:'W',label:'Work (W)',unit:'J'},{id:'t',label:'Time (t)',unit:'s'}],solve:{P:({W,t})=>W/t,W:({P,t})=>P*t,t:({W,P})=>W/P}},
