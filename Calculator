let phyCat='Mechanics';
function initPhysics(){const bar=document.getElementById('phy-cat-bar');Object.keys(physicsData).forEach(cat=>{const b=document.createElement('button');b.className='phy-cat-btn'+(cat===phyCat?' active':'');b.textContent=cat;b.onclick=()=>{tap();selectPhyCat(cat);};bar.appendChild(b);});renderPhyFormulas();}
function selectPhyCat(cat){phyCat=cat;document.querySelectorAll('.phy-cat-btn').forEach(b=>b.classList.toggle('active',b.textContent===cat));renderPhyFormulas();}
function renderPhyFormulas(){const list=document.getElementById('phy-formula-list');list.innerHTML='';physicsData[phyCat].forEach((formula,fi)=>{const card=document.createElement('div');card.className='phy-formula-card';card.innerHTML=`<div class="phy-formula-header" onclick="togglePhyCard(${fi})"><span class="phy-formula-name">${formula.name}</span><span class="phy-formula-eq">${formula.eq}</span></div><div class="phy-formula-body" id="phy-body-${fi}">${formula.vars.map(v=>`<div class="phy-var-row"><label class="phy-var-label">${v.label}</label><input class="phy-var-input" id="phy-${fi}-${v.id}" type="number" placeholder="?" /><span class="phy-var-unit">${v.unit}</span></div>`).join('')}<button class="phy-solve-btn" onclick="solvePhysics(${fi})">Solve missing variable</button><div class="phy-result" id="phy-result-${fi}"></div></div>`;list.appendChild(card);});}
function togglePhyCard(fi){tap();const body=document.getElementById('phy-body-'+fi);const isOpen=body.classList.contains('open');document.querySelectorAll('.phy-formula-body').forEach(b=>b.classList.remove('open'));if(!isOpen)body.classList.add('open');}
function solvePhysics(fi){tap();const formula=physicsData[phyCat][fi];const vals={};let missing=null,multiMissing=false;formula.vars.forEach(v=>{const val=parseFloat(document.getElementById(`phy-${fi}-${v.id}`).value);if(isNaN(val)){if(missing)multiMissing=true;else missing=v;}else vals[v.id]=val;});const resultEl=document.getElementById(`phy-result-${fi}`);resultEl.style.display='block';if(!missing){resultEl.textContent='⚠ Leave one field empty to solve for it';return;}if(multiMissing){resultEl.textContent='⚠ Fill all but one field';return;}if(!formula.solve[missing.id]){resultEl.textContent='⚠ Cannot solve for this variable directly';return;}try{const res=formula.solve[missing.id](vals);if(isNaN(res)||!isFinite(res)){resultEl.textContent='⚠ Invalid values';return;}const rounded=parseFloat(res.toFixed(6));resultEl.textContent=`${missing.label.split('(')[0].trim()} = ${rounded} ${missing.unit}`;document.getElementById(`phy-${fi}-${missing.id}`).value=rounded;}catch{resultEl.textContent='⚠ Cannot solve with these values';}}

