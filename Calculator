<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#050508">
    <title>Smart Calculator</title>
    <style>
        :root {
            --text: rgba(255,255,255,0.92);
            --muted: rgba(255,255,255,0.28);
            --accent: rgba(255,255,255,0.55);
            --blue: #38bdf8;
            --green: #34d399;
            --red: #f87171;
            --purple: #a78bfa;
            --orange: #fb923c;
        }
        * { box-sizing:border-box; margin:0; padding:0; font-family:-apple-system,'SF Pro Display',system-ui,sans-serif; -webkit-tap-highlight-color:transparent; }
        body {
            background:
                radial-gradient(ellipse at 30% 20%, rgba(99,102,241,0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 75% 75%, rgba(52,211,153,0.07) 0%, transparent 55%),
                radial-gradient(ellipse at 10% 80%, rgba(168,85,247,0.08) 0%, transparent 50%),
                #050508;
            background-attachment:fixed; color:var(--text); height:100vh;
            display:flex; justify-content:center; align-items:center; overflow:hidden;
        }
        .calc-app { width:100vw; height:100vh; max-width:480px; padding:14px; display:flex; flex-direction:column; gap:9px; }
        .top-bar { display:flex; justify-content:space-between; align-items:center; height:32px; flex-shrink:0; }
        .deg-toggle { background:rgba(255,255,255,0.06); border:0.5px solid rgba(56,189,248,0.3); color:var(--blue); padding:5px 14px; border-radius:20px; font-size:0.72rem; font-weight:600; letter-spacing:0.08em; }
        .tape-btn { background:rgba(255,255,255,0.06); border:0.5px solid rgba(255,255,255,0.1); color:var(--muted); padding:5px 14px; border-radius:20px; font-size:0.78rem; }
        .screen { background:rgba(20,20,35,0.85); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border-radius:24px; padding:20px 22px 16px; border:0.5px solid rgba(255,255,255,0.1); box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.12), 0 20px 40px rgba(0,0,0,0.4); display:flex; flex-direction:column; justify-content:flex-end; height:118px; flex-shrink:0; cursor:pointer; user-select:none; }
        .expr { color:var(--muted); font-size:0.9rem; font-weight:300; text-align:right; min-height:1.2rem; }
        .output { color:var(--text); font-size:2.8rem; font-weight:200; letter-spacing:-0.03em; text-align:right; overflow-x:auto; white-space:nowrap; }
        .copy-hint { font-size:0.62rem; color:rgba(56,189,248,0.5); text-align:right; margin-top:2px; }
        @keyframes flash { 0%,100%{opacity:1} 50%{opacity:0.35} }
        .flashing { animation:flash 0.25s ease; }
        .tab-bar { display:flex; gap:4px; background:rgba(255,255,255,0.04); border:0.5px solid rgba(255,255,255,0.07); border-radius:14px; padding:3px; overflow-x:auto; flex-shrink:0; scrollbar-width:none; }
        .tab-bar::-webkit-scrollbar { display:none; }
        .tab { flex-shrink:0; padding:7px 10px; border-radius:11px; border:none; outline:none; font-size:0.65rem; font-weight:600; letter-spacing:0.07em; color:var(--muted); background:transparent; transition:background 0.18s, color 0.18s; white-space:nowrap; }
        .tab.active { background:rgba(255,255,255,0.1); color:var(--text); box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.14); }
        .panels { flex:1; position:relative; min-height:0; overflow:hidden; }
        .panel { position:absolute; inset:0; display:flex; flex-direction:column; gap:7px; overflow-y:auto; }
        .panel.hidden { display:none; }
        .panel::-webkit-scrollbar { width:3px; }
        .panel::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:2px; }

        /* CALC */
        .keypad { display:grid; grid-template-columns:repeat(5,1fr); gap:7px; flex:1; min-height:0; }
        button { position:relative; overflow:hidden; border:0.5px solid rgba(255,255,255,0.08); outline:none; font-size:0.98rem; font-weight:300; border-radius:18px; color:var(--text); display:flex; align-items:center; justify-content:center; user-select:none; touch-action:manipulation; box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.12), inset 0 -0.5px 0 rgba(0,0,0,0.25), 0 2px 6px rgba(0,0,0,0.3); transition:transform 0.08s ease, filter 0.08s ease; }
        button::before { content:""; position:absolute; top:0; left:8%; right:8%; height:0.5px; background:rgba(255,255,255,0.28); pointer-events:none; }
        button:active { transform:scale(0.93); filter:brightness(0.7); }
        .b-num { background:rgba(255,255,255,0.05); }
        .b-op  { background:rgba(255,255,255,0.09); }
        .b-sci { background:rgba(255,255,255,0.03); color:var(--accent); font-size:0.82rem; }
        .b-clear { background:rgba(180,40,40,0.35); }
        .b-eq  { background:rgba(30,120,80,0.4); grid-column:span 2; font-size:1.3rem; font-weight:300; }

        /* GRAPH */
        .graph-row { display:flex; gap:7px; flex-shrink:0; }
        .graph-input { flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:14px; padding:10px 14px; color:var(--text); font-size:0.9rem; outline:none; font-family:inherit; }
        .graph-input::placeholder { color:var(--muted); }
        .plot-btn { background:rgba(56,189,248,0.15); border:0.5px solid rgba(56,189,248,0.25); border-radius:14px; padding:10px 16px; color:var(--blue); font-size:0.85rem; font-weight:500; }
        .canvas-wrap { flex:1; position:relative; border-radius:18px; overflow:hidden; border:0.5px solid rgba(255,255,255,0.07); background:rgba(8,8,18,0.7); min-height:0; }
        #graph-canvas { display:block; width:100%; height:100%; }
        .graph-hint { position:absolute; top:10px; left:50%; transform:translateX(-50%); font-size:0.68rem; color:rgba(255,255,255,0.18); pointer-events:none; white-space:nowrap; }
        .zoom-btns { position:absolute; bottom:12px; right:12px; display:flex; flex-direction:column; gap:6px; }
        .zoom-btns button { width:36px; height:36px; border-radius:12px; background:rgba(255,255,255,0.07); border:0.5px solid rgba(255,255,255,0.1); font-size:1rem; }

        /* CONVERT */
        .cat-bar { display:flex; gap:6px; overflow-x:auto; flex-shrink:0; padding-bottom:2px; scrollbar-width:none; }
        .cat-bar::-webkit-scrollbar { display:none; }
        .cat-btn { flex-shrink:0; padding:6px 14px; border-radius:20px; font-size:0.7rem; font-weight:600; border:0.5px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.04); color:var(--muted); }
        .cat-btn.active { background:rgba(56,189,248,0.14); color:var(--blue); border-color:rgba(56,189,248,0.25); }
        .conv-body { flex:1; display:flex; flex-direction:column; justify-content:center; gap:10px; }
        .conv-row { display:flex; align-items:stretch; gap:8px; }
        .conv-num { flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:14px; padding:14px 16px; color:var(--text); font-size:1.3rem; font-weight:200; outline:none; font-family:inherit; text-align:right; min-width:0; }
        .conv-num::placeholder { color:var(--muted); }
        .conv-unit { background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:14px; padding:0 12px; color:var(--text); font-size:0.88rem; outline:none; font-family:inherit; appearance:none; -webkit-appearance:none; min-width:75px; text-align:center; }
        .swap-btn { align-self:center; background:rgba(255,255,255,0.06); border:0.5px solid rgba(255,255,255,0.1); border-radius:14px; width:44px; height:44px; font-size:1.3rem; flex-shrink:0; }
        .conv-result { background:rgba(255,255,255,0.03); border:0.5px solid rgba(255,255,255,0.07); border-radius:16px; padding:16px 18px; text-align:center; }
        .conv-result-label { font-size:0.72rem; color:var(--muted); letter-spacing:0.05em; margin-bottom:4px; }
        .conv-result-val { font-size:1.1rem; font-weight:200; }

        /* MONEY */
        .money-card { background:rgba(255,255,255,0.04); border:0.5px solid rgba(255,255,255,0.08); border-radius:18px; padding:14px 16px; flex-shrink:0; }
        .money-title { font-size:0.68rem; font-weight:600; letter-spacing:0.09em; text-transform:uppercase; color:var(--muted); margin-bottom:10px; }
        .money-row { display:flex; gap:8px; align-items:center; margin-bottom:8px; }
        .money-input { flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:12px; padding:10px 14px; color:var(--text); font-size:1rem; font-weight:200; outline:none; font-family:inherit; min-width:0; }
        .money-input::placeholder { color:var(--muted); }
        .money-select { background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:12px; padding:10px; color:var(--text); font-size:0.82rem; outline:none; font-family:inherit; appearance:none; -webkit-appearance:none; }
        .income-summary { display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px; margin-top:10px; }
        .inc-cell { background:rgba(52,211,153,0.07); border:0.5px solid rgba(52,211,153,0.15); border-radius:12px; padding:10px 8px; text-align:center; }
        .inc-cell-label { font-size:0.6rem; color:var(--muted); letter-spacing:0.06em; margin-bottom:3px; }
        .inc-cell-val { font-size:0.95rem; font-weight:300; color:var(--green); }
        .payday-badge { background:rgba(56,189,248,0.08); border:0.5px solid rgba(56,189,248,0.15); border-radius:12px; padding:8px 12px; margin-top:8px; text-align:center; font-size:0.78rem; color:var(--blue); font-weight:300; }
        .exp-add-row { display:flex; gap:6px; }
        .exp-name-input { flex:2; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:12px; padding:9px 12px; color:var(--text); font-size:0.88rem; outline:none; font-family:inherit; min-width:0; }
        .exp-name-input::placeholder { color:var(--muted); }
        .exp-amt-input { flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:12px; padding:9px 10px; color:var(--text); font-size:0.88rem; outline:none; font-family:inherit; text-align:right; min-width:0; }
        .exp-amt-input::placeholder { color:var(--muted); }
        .exp-add-btn { background:rgba(52,211,153,0.15); border:0.5px solid rgba(52,211,153,0.25); border-radius:12px; padding:9px 12px; color:var(--green); font-size:0.85rem; font-weight:500; flex-shrink:0; }
        .exp-list { display:flex; flex-direction:column; gap:5px; max-height:150px; overflow-y:auto; margin-top:8px; }
        .exp-item { display:flex; justify-content:space-between; align-items:center; background:rgba(255,255,255,0.03); border:0.5px solid rgba(255,255,255,0.06); border-radius:10px; padding:8px 12px; }
        .exp-item-name { font-size:0.85rem; color:var(--text); font-weight:300; }
        .exp-item-right { display:flex; align-items:center; gap:8px; }
        .exp-item-amt { font-size:0.85rem; color:var(--red); font-weight:300; }
        .exp-del { background:none !important; border:none !important; box-shadow:none !important; color:rgba(255,255,255,0.2); font-size:1rem; padding:0 4px; min-width:auto; }
        .exp-del::before { display:none; }
        .money-summary-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
        .msummary-cell { border-radius:14px; padding:12px 14px; }
        .msummary-cell.earned { background:rgba(52,211,153,0.08); border:0.5px solid rgba(52,211,153,0.15); }
        .msummary-cell.spent  { background:rgba(248,113,113,0.08); border:0.5px solid rgba(248,113,113,0.15); }
        .msummary-cell.saved  { background:rgba(56,189,248,0.08); border:0.5px solid rgba(56,189,248,0.15); grid-column:span 2; }
        .msummary-label { font-size:0.62rem; color:var(--muted); letter-spacing:0.07em; text-transform:uppercase; margin-bottom:4px; }
        .msummary-val { font-size:1.1rem; font-weight:200; }
        .msummary-cell.earned .msummary-val { color:var(--green); }
        .msummary-cell.spent  .msummary-val { color:var(--red); }
        .msummary-cell.saved  .msummary-val { color:var(--blue); }
        .msummary-sub { font-size:0.7rem; color:var(--muted); margin-top:2px; }

        /* PHYSICS */
        .phy-sub-bar { display:flex; gap:6px; flex-shrink:0; background:rgba(255,255,255,0.04); border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:3px; }
        .phy-sub-btn { flex:1; padding:7px; border-radius:9px; border:none; outline:none; font-size:0.7rem; font-weight:600; letter-spacing:0.07em; color:var(--muted); background:transparent; transition:background 0.18s, color 0.18s; }
        .phy-sub-btn.active { background:rgba(167,139,250,0.15); color:var(--purple); }
        .phy-cat-bar { display:flex; gap:6px; overflow-x:auto; flex-shrink:0; scrollbar-width:none; padding-bottom:2px; }
        .phy-cat-bar::-webkit-scrollbar { display:none; }
        .phy-cat-btn { flex-shrink:0; padding:6px 14px; border-radius:20px; font-size:0.7rem; font-weight:600; border:0.5px solid rgba(255,255,255,0.08); background:rgba(255,255,255,0.04); color:var(--muted); }
        .phy-cat-btn.active { background:rgba(167,139,250,0.14); color:var(--purple); border-color:rgba(167,139,250,0.25); }
        .phy-formula-list { display:flex; flex-direction:column; gap:6px; }
        .phy-formula-card { background:rgba(255,255,255,0.04); border:0.5px solid rgba(255,255,255,0.08); border-radius:16px; overflow:hidden; flex-shrink:0; }
        .phy-formula-header { display:flex; justify-content:space-between; align-items:center; padding:12px 14px; cursor:pointer; }
        .phy-formula-name { font-size:0.88rem; font-weight:400; }
        .phy-formula-eq { font-size:0.75rem; color:var(--purple); font-family:monospace; background:rgba(167,139,250,0.08); padding:3px 8px; border-radius:6px; flex-shrink:0; margin-left:6px; }
        .phy-formula-body { padding:0 14px; max-height:0; overflow:hidden; transition:max-height 0.25s ease, padding 0.25s ease; }
        .phy-formula-body.open { max-height:500px; padding:0 14px 14px; }
        .phy-var-row { display:flex; align-items:center; gap:8px; margin-bottom:7px; }
        .phy-var-label { font-size:0.76rem; color:var(--muted); min-width:110px; }
        .phy-var-input { flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1); border-radius:10px; padding:8px 12px; color:var(--text); font-size:0.9rem; outline:none; font-family:inherit; text-align:right; min-width:0; }
        .phy-var-input::placeholder { color:rgba(255,255,255,0.15); }
        .phy-var-unit { font-size:0.72rem; color:var(--muted); min-width:36px; }
        .phy-solve-btn { width:100%; margin-top:4px; background:rgba(167,139,250,0.15); border:0.5px solid rgba(167,139,250,0.25); border-radius:12px; padding:10px; color:var(--purple); font-size:0.85rem; font-weight:500; }
        .phy-result { margin-top:8px; background:rgba(167,139,250,0.07); border:0.5px solid rgba(167,139,250,0.15); border-radius:10px; padding:10px 14px; font-size:0.9rem; font-weight:200; display:none; text-align:center; }

        /* ══ SIMULATOR (redesigned) ══ */
        .sim-section { display:flex; flex-direction:column; gap:8px; flex:1; min-height:0; }

        .sim-scene-bar {
            display:grid; grid-template-columns:repeat(4,1fr); gap:4px;
            flex-shrink:0; background:rgba(255,255,255,0.03);
            border:0.5px solid rgba(255,255,255,0.07); border-radius:14px; padding:4px;
        }
        .sim-scene-btn {
            padding:8px 4px; border-radius:10px; border:none; outline:none;
            color:var(--muted); background:transparent;
            transition:all 0.2s ease;
            display:flex; flex-direction:column; align-items:center; gap:3px;
        }
        .sim-scene-btn .s-icon { font-size:1.2rem; line-height:1; }
        .sim-scene-btn .s-label { font-size:0.58rem; font-weight:700; letter-spacing:0.05em; }
        .sim-scene-btn.active {
            background:linear-gradient(150deg, rgba(251,146,60,0.22), rgba(251,146,60,0.06));
            color:var(--orange);
            box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.14), 0 0 12px rgba(251,146,60,0.08);
            border:0.5px solid rgba(251,146,60,0.2);
        }

        .sim-canvas-wrap {
            flex:1; border-radius:18px; overflow:hidden;
            border:0.5px solid rgba(255,255,255,0.07);
            background:#020208; position:relative; min-height:0;
            box-shadow:inset 0 1px 0 rgba(255,255,255,0.04), 0 0 30px rgba(0,0,0,0.6);
        }
        #sim-canvas { display:block; width:100%; height:100%; touch-action:none; }

        .sim-stats {
            position:absolute; top:7px; left:7px; right:7px;
            display:flex; flex-wrap:wrap; gap:4px; pointer-events:none;
        }
        .sim-stat {
            font-size:0.6rem; color:rgba(255,255,255,0.65); font-family:monospace;
            background:rgba(0,0,0,0.55);
            padding:3px 9px; border-radius:20px;
            border:0.5px solid rgba(255,255,255,0.08);
        }
        .sim-stat b { color:var(--orange); font-weight:600; }

        .sim-hint-overlay {
            position:absolute; bottom:9px; left:50%; transform:translateX(-50%);
            font-size:0.58rem; color:rgba(255,255,255,0.18);
            pointer-events:none; white-space:nowrap; letter-spacing:0.06em;
        }

        .sim-controls {
            flex-shrink:0; background:rgba(255,255,255,0.03);
            border:0.5px solid rgba(255,255,255,0.06);
            border-radius:16px; padding:10px 13px; display:flex; flex-direction:column; gap:7px;
        }
        .sim-ctrl-row { display:flex; align-items:center; gap:9px; }
        .sim-ctrl-label { font-size:0.65rem; color:var(--muted); min-width:78px; }
        .sim-slider {
            flex:1; -webkit-appearance:none; appearance:none; height:3px; border-radius:3px;
            outline:none; border:none; box-shadow:none; cursor:pointer;
            background:rgba(255,255,255,0.1);
        }
        .sim-slider::before { display:none; }
        .sim-slider::-webkit-slider-thumb {
            -webkit-appearance:none; width:18px; height:18px; border-radius:50%;
            background:radial-gradient(circle at 35% 35%, rgba(255,255,255,0.6), var(--orange));
            cursor:pointer;
            box-shadow:0 0 10px rgba(251,146,60,0.55), 0 0 0 3px rgba(251,146,60,0.18);
        }
        .sim-val { font-size:0.7rem; color:var(--orange); min-width:40px; text-align:right; font-family:monospace; font-weight:700; }

        .sim-btn-row { display:flex; gap:7px; }
        .sim-launch-btn {
            flex:1;
            background:linear-gradient(135deg, rgba(251,146,60,0.28), rgba(251,146,60,0.1));
            border:0.5px solid rgba(251,146,60,0.4); border-radius:13px; padding:11px;
            color:var(--orange); font-size:0.88rem; font-weight:700; letter-spacing:0.03em;
            box-shadow:0 0 20px rgba(251,146,60,0.12), inset 0 0.5px 0 rgba(255,255,255,0.18);
        }
        .sim-reset-btn {
            background:rgba(255,255,255,0.04); border:0.5px solid rgba(255,255,255,0.09);
            border-radius:13px; padding:11px 15px; color:var(--muted); font-size:0.85rem;
        }

        /* TAPE */
        .tape { position:fixed; top:0; right:-100%; width:82%; max-width:320px; height:100%; background:rgba(8,8,14,0.94); backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px); border-left:0.5px solid rgba(255,255,255,0.08); box-shadow:-20px 0 60px rgba(0,0,0,0.7); transition:right 0.3s cubic-bezier(0.4,0,0.2,1); z-index:100; padding:28px 16px 20px; display:flex; flex-direction:column; }
        .tape.open { right:0; }
        .tape-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
        .tape-title { font-size:0.75rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); }
        .tape-clear-btn { background:none !important; border:none !important; box-shadow:none !important; color:rgba(200,60,60,0.8); font-size:0.8rem; }
        .tape-clear-btn::before { display:none; }
        .tape-scroll { flex:1; overflow-y:auto; display:flex; flex-direction:column; }
        .tape-entry { position:relative; padding:10px 14px; margin-left:14px; border-left:1px solid rgba(255,255,255,0.07); cursor:pointer; }
        .tape-entry::before { content:""; position:absolute; left:-4.5px; top:15px; width:8px; height:8px; border-radius:50%; background:rgba(56,189,248,0.2); border:1px solid rgba(56,189,248,0.3); }
        .tape-expr { font-size:0.75rem; color:var(--muted); margin-bottom:2px; }
        .tape-val { font-size:1rem; font-weight:200; }
        .tape-close { margin-top:14px; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.08); padding:12px; border-radius:14px; font-size:0.88rem; }
    </style>
</head>
<body>
<div class="calc-app">
    <div class="top-bar">
        <button class="deg-toggle" id="deg-btn" onclick="tap();toggleDeg()">DEG</button>
        <button class="tape-btn" onclick="tap();toggleTape()">📋 Tape</button>
    </div>
    <div class="screen" onclick="copyResult()">
