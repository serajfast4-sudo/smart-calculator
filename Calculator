        {name:"Period",eq:"T=1/f",vars:[{id:'T',label:'Period (T)',unit:'s'},{id:'f',label:'Frequency (f)',unit:'Hz'}],solve:{T:({f})=>1/f,f:({T})=>1/T}},
    ],
    Electric:[
        {name:"Ohm's Law",eq:"V=IR",vars:[{id:'V',label:'Voltage (V)',unit:'V'},{id:'I',label:'Current (I)',unit:'A'},{id:'R',label:'Resistance (R)',unit:'Ω'}],solve:{V:({I,R})=>I*R,I:({V,R})=>V/R,R:({V,I})=>V/I}},
        {name:"Electric Power",eq:"P=VI",vars:[{id:'P',label:'Power (P)',unit:'W'},{id:'V',label:'Voltage (V)',unit:'V'},{id:'I',label:'Current (I)',unit:'A'}],solve:{P:({V,I})=>V*I,V:({P,I})=>P/I,I:({P,V})=>P/V}},
        {name:"Electric Charge",eq:"Q=It",vars:[{id:'Q',label:'Charge (Q)',unit:'C'},{id:'I',label:'Current (I)',unit:'A'},{id:'t',label:'Time (t)',unit:'s'}],solve:{Q:({I,t})=>I*t,I:({Q,t})=>Q/t,t:({Q,I})=>Q/I}},
    ],
    Thermo:[
        {name:"Ideal Gas Law",eq:"PV=nRT",vars:[{id:'P',label:'Pressure (P)',unit:'Pa'},{id:'V',label:'Volume (V)',unit:'m³'},{id:'n',label:'Moles (n)',unit:'mol'},{id:'T',label:'Temp (T)',unit:'K'}],solve:{P:({V,n,T})=>n*8.314*T/V,V:({P,n,T})=>n*8.314*T/P,n:({P,V,T})=>P*V/(8.314*T),T:({P,V,n})=>P*V/(n*8.314)}},
        {name:"Heat Transfer",eq:"Q=mcΔT",vars:[{id:'Q',label:'Heat (Q)',unit:'J'},{id:'m',label:'Mass (m)',unit:'kg'},{id:'c',label:'Specific heat',unit:'J/kg·K'},{id:'dT',label:'Temp change ΔT',unit:'K'}],solve:{Q:({m,c,dT})=>m*c*dT,m:({Q,c,dT})=>Q/(c*dT),c:({Q,m,dT})=>Q/(m*dT),dT:({Q,m,c})=>Q/(m*c)}},
