let simCanvas, simCtx, simRAF=null, simScene='projectile';
const SIM={};

// ── Drawing helpers ──
const W=()=>simCanvas.width, H=()=>simCanvas.height;

function drawSimBG(){
    const ctx=simCtx, w=W(), h=H();
    ctx.fillStyle='#020208'; ctx.fillRect(0,0,w,h);
    // dot grid
    ctx.fillStyle='rgba(255,255,255,0.025)';
    const sp=22;
    for(let x=sp;x<w;x+=sp) for(let y=sp;y<h;y+=sp){ctx.beginPath();ctx.arc(x,y,0.9,0,Math.PI*2);ctx.fill();}
    // center ambient glow
    const cg=ctx.createRadialGradient(w/2,h/2,0,w/2,h/2,w*0.7);
    cg.addColorStop(0,'rgba(99,102,241,0.03)'); cg.addColorStop(1,'transparent');
    ctx.fillStyle=cg; ctx.fillRect(0,0,w,h);
}

function drawGround(y){
    const ctx=simCtx;
    ctx.save();
    ctx.shadowColor='rgba(255,255,255,0.25)'; ctx.shadowBlur=6;
    ctx.strokeStyle='rgba(255,255,255,0.12)'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W(),y); ctx.stroke();
    ctx.restore();
    const grd=ctx.createLinearGradient(0,y,0,y+18);
    grd.addColorStop(0,'rgba(255,255,255,0.03)'); grd.addColorStop(1,'transparent');
    ctx.fillStyle=grd; ctx.fillRect(0,y,W(),18);
}

function glowCircle(ctx,x,y,r,color,glowColor,blur=18){
    ctx.save();
    ctx.shadowColor=glowColor||color; ctx.shadowBlur=blur;
    const g=ctx.createRadialGradient(x-r*.3,y-r*.35,r*.05,x,y,r);
    g.addColorStop(0,'rgba(255,255,255,0.55)');
    g.addColorStop(0.35,color);
    g.addColorStop(1,color+'88');
    ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2);
    ctx.fillStyle=g; ctx.fill();
    ctx.shadowBlur=0;
    ctx.strokeStyle='rgba(255,255,255,0.18)'; ctx.lineWidth=0.8; ctx.stroke();
    ctx.restore();
}

function setStat(html){document.getElementById('sim-stats').innerHTML=html;}
function setHint(t){document.getElementById('sim-hint').textContent=t;}
function chip(label,val){return`<div class="sim-stat">${label} <b>${val}</b></div>`;}

function refreshSliders(){
    document.querySelectorAll('.sim-slider').forEach(s=>{
        const pct=(s.value-s.min)/(s.max-s.min)*100;
        s.style.background=`linear-gradient(to right,rgba(251,146,60,0.8) ${pct}%,rgba(255,255,255,0.1) ${pct}%)`;
    });
}

// ── Touch dispatcher ──
function initSim(){
    simCanvas=document.getElementById('sim-canvas');
    const wrap=simCanvas.parentElement;
    simCanvas.width=wrap.offsetWidth; simCanvas.height=wrap.offsetHeight;
    simCtx=simCanvas.getContext('2d');

    function coord(touch){
        const r=simCanvas.getBoundingClientRect();
        return{
            x:(touch.clientX-r.left)*(simCanvas.width/r.width),
            y:(touch.clientY-r.top)*(simCanvas.height/r.height)
        };
    }
    simCanvas.addEventListener('touchstart',e=>{e.preventDefault();const c=coord(e.touches[0]);SIM[simScene]&&SIM[simScene].touch&&SIM[simScene].touch('start',c.x,c.y);},{passive:false});
    simCanvas.addEventListener('touchmove',e=>{e.preventDefault();const c=coord(e.touches[0]);SIM[simScene]&&SIM[simScene].touch&&SIM[simScene].touch('move',c.x,c.y);},{passive:false});
    simCanvas.addEventListener('touchend',e=>{e.preventDefault();SIM[simScene]&&SIM[simScene].touch&&SIM[simScene].touch('end',0,0);},{passive:false});

    selectScene('projectile');
}

function startSimLoop(){if(simRAF)return;loop();}
function stopSimLoop(){if(simRAF){cancelAnimationFrame(simRAF);simRAF=null;}}
function loop(){simRAF=requestAnimationFrame(loop);SIM[simScene]&&SIM[simScene].tick&&SIM[simScene].tick();}

function selectScene(name){
    tap(); stopSimLoop();
    simScene=name;
    document.querySelectorAll('.sim-scene-btn').forEach((b,i)=>{
        b.classList.toggle('active',['projectile','pendulum','spring','collision'][i]===name);
    });
    if(!simCanvas)return;
    simCtx.clearRect(0,0,simCanvas.width,simCanvas.height);
    setStat(''); setHint('');
    SIM[name].init();
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  PROJECTILE — slingshot touch
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SIM.projectile=(()=>{
    let s={};
    const LX=()=>55, LY=()=>H()-55;

    function fresh(){return{px:LX(),py:LY(),vx:0,vy:0,running:false,landed:false,dragging:false,dragX:LX(),dragY:LY()-50,trail:[],t:0,maxH:0,range:0,particles:[]};}

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Gravity (m/s²)</span><input type="range" class="sim-slider" id="sim-grav" min="1" max="25" value="10" oninput="document.getElementById('sv-grav').textContent=this.value;refreshSliders()"><span class="sim-val" id="sv-grav">10</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Power limit</span><input type="range" class="sim-slider" id="sim-pow" min="3" max="10" value="6" oninput="document.getElementById('sv-pow').textContent=this.value;refreshSliders()"><span class="sim-val" id="sv-pow">6</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.projectile.launch()">🚀 Launch</button><button class="sim-reset-btn" onclick="SIM.projectile.reset()">Reset</button></div>`;
        setTimeout(refreshSliders,10);
    }

    function init(){buildControls();s=fresh();draw();setHint('✦ drag back from ball · release to launch');}
    function reset(){stopSimLoop();s=fresh();setStat('');draw();setHint('✦ drag back from ball · release to launch');}

    function launch(){
        if(s.running)return;
        const pow=parseFloat(document.getElementById('sim-pow').value)||6;
        const dx=LX()-s.dragX, dy=LY()-s.dragY;
        const dist=Math.sqrt(dx*dx+dy*dy);
        const speed=Math.min(dist*pow*0.12,pow*40);
        const ang=Math.atan2(dy,dx);
        s.vx=Math.cos(ang)*speed; s.vy=Math.sin(ang)*speed;
        s.px=LX(); s.py=LY(); s.trail=[]; s.t=0; s.maxH=0; s.running=true; s.landed=false;
        setHint('');
        startSimLoop();
    }

    function touch(type,x,y){
        if(s.running)return;
        if(type==='start'){s.dragging=true;s.dragX=x;s.dragY=y;}
        else if(type==='move'&&s.dragging){s.dragX=x;s.dragY=y;draw();}
        else if(type==='end'&&s.dragging){s.dragging=false;launch();}
    }

    function tick(){
        if(!s.running||s.landed)return;
        const grav=parseFloat(document.getElementById('sim-grav').value)||10;
        const dt=0.016;
        s.vy+=grav*3.8*dt; s.px+=s.vx*dt; s.py+=s.vy*dt; s.t+=dt;
        s.trail.push({x:s.px,y:s.py});
        if(s.trail.length>220)s.trail.shift();
        const curH=Math.max(0,(LY()-s.py)/3.8);
        if(curH>s.maxH)s.maxH=curH;
        if(s.py>=LY()){
            s.py=LY(); s.running=false; s.landed=true;
            s.range=(s.px-LX())/3.8;
            // burst particles
            for(let i=0;i<16;i++) s.particles.push({x:s.px,y:s.py,vx:(Math.random()-0.5)*120,vy:-Math.random()*90,life:1});
            setStat(chip('Max height',s.maxH.toFixed(1)+' m')+chip('Range',s.range.toFixed(1)+' m')+chip('Time',s.t.toFixed(2)+' s'));
            setHint('✦ drag to aim again');
        }
        if(s.running) setStat(chip('H',((LY()-s.py)/3.8).toFixed(1)+' m')+chip('v',(Math.sqrt(s.vx*s.vx+s.vy*s.vy)/3.8).toFixed(1)+' m/s')+chip('t',s.t.toFixed(2)+' s'));
        // animate particles
        s.particles.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=120*dt;p.life-=dt*2;});
        s.particles=s.particles.filter(p=>p.life>0);
        if(!s.running&&s.particles.length===0){stopSimLoop();return;}
        draw();
    }

    function draw(){
        const ctx=simCtx; drawSimBG();
        const grav=parseFloat((document.getElementById('sim-grav')||{value:10}).value)||10;
        const pow=parseFloat((document.getElementById('sim-pow')||{value:6}).value)||6;
        const gY=LY();
        drawGround(gY);

        // preview trajectory (dashed)
        if(!s.running&&!s.landed){
            const dx=LX()-s.dragX, dy=gY-s.dragY;
            const dist=Math.sqrt(dx*dx+dy*dy);
            const speed=Math.min(dist*pow*0.12,pow*40);
            const ang=Math.atan2(LX()-s.dragX>0?dy:dy, dx);
            let sx=LX(),sy=gY,svx=Math.cos(ang)*speed,svy=Math.sin(ang)*speed;
            ctx.save(); ctx.setLineDash([3,7]);
            ctx.strokeStyle='rgba(251,146,60,0.25)'; ctx.lineWidth=1.5;
            ctx.beginPath(); ctx.moveTo(sx,sy);
            for(let i=0;i<200;i++){svy+=grav*3.8*0.016;sx+=svx*0.016;sy+=svy*0.016;if(sy>=gY)break;ctx.lineTo(sx,sy);}
            ctx.stroke(); ctx.setLineDash([]); ctx.restore();

            // slingshot fork
            ctx.save();
            ctx.strokeStyle='rgba(255,255,255,0.2)'; ctx.lineWidth=3; ctx.lineCap='round';
            ctx.beginPath(); ctx.moveTo(LX(),gY+8); ctx.lineTo(LX(),gY-18); ctx.lineTo(LX()-12,gY-6);
            ctx.moveTo(LX(),gY-18); ctx.lineTo(LX()+12,gY-6); ctx.stroke();
            // elastic bands
            ctx.save();
            ctx.shadowColor='rgba(251,146,60,0.5)'; ctx.shadowBlur=6;
            ctx.strokeStyle='rgba(251,146,60,0.55)'; ctx.lineWidth=2;
            ctx.beginPath();
            ctx.moveTo(LX()-12,gY-6); ctx.lineTo(s.dragX,s.dragY);
            ctx.moveTo(LX()+12,gY-6); ctx.lineTo(s.dragX,s.dragY);
            ctx.stroke(); ctx.restore(); ctx.restore();
        }

        // trail with glow gradient
        for(let i=1;i<s.trail.length;i++){
            const a=i/s.trail.length;
            ctx.save(); ctx.globalAlpha=a;
            ctx.shadowColor='#fb923c'; ctx.shadowBlur=a*10;
            ctx.strokeStyle=`rgba(251,146,60,${a*0.7})`; ctx.lineWidth=2.5;
            ctx.beginPath(); ctx.moveTo(s.trail[i-1].x,s.trail[i-1].y); ctx.lineTo(s.trail[i].x,s.trail[i].y); ctx.stroke();
            ctx.restore();
        }

        // burst particles
        s.particles.forEach(p=>{
            ctx.save(); ctx.globalAlpha=p.life;
            ctx.shadowColor='#fb923c'; ctx.shadowBlur=8;
            ctx.fillStyle=`rgba(251,146,60,${p.life})`;
            ctx.beginPath(); ctx.arc(p.x,p.y,3*p.life,0,Math.PI*2); ctx.fill();
            ctx.restore();
        });

        // ball
        const bx=s.running||s.landed?s.px:s.dragX||LX();
        const by_=s.running||s.landed?s.py:s.dragY||gY;
        glowCircle(ctx,s.running||s.landed?s.px:LX(),s.running||s.landed?s.py:gY,11,'#fb923c','#fb923c',s.running?22:14);
    }

    return{init,reset,launch,tick,touch};
})();

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  PENDULUM — drag bob to set angle
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SIM.pendulum=(()=>{
    let angle=Math.PI/6, omega=0, running=false, trail=[], dragging=false, t=0;
    const pivX=()=>W()/2, pivY=()=>38;
    const len=()=>Math.min(H()*0.52,W()*0.52);

    function bobPos(){return{x:pivX()+Math.sin(angle)*len(), y:pivY()+Math.cos(angle)*len()};}

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Damping</span><input type="range" class="sim-slider" id="sim-damp" min="0" max="8" step="0.1" value="1" oninput="document.getElementById('sv-damp').textContent=parseFloat(this.value).toFixed(1);refreshSliders()"><span class="sim-val" id="sv-damp">1.0</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Length</span><input type="range" class="sim-slider" id="sim-plen" min="40" max="100" value="70" oninput="document.getElementById('sv-plen').textContent=this.value+'%';if(!running)SIM.pendulum.draw();refreshSliders()"><span class="sim-val" id="sv-plen">70%</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.pendulum.toggle()">▶ Start</button><button class="sim-reset-btn" onclick="SIM.pendulum.reset()">Reset</button></div>`;
        setTimeout(refreshSliders,10);
    }

    function init(){buildControls();angle=Math.PI/5;omega=0;running=false;trail=[];draw();setHint('✦ drag the bob · release to swing');}

    function reset(){stopSimLoop();running=false;angle=Math.PI/5;omega=0;trail=[];setStat('');draw();setHint('✦ drag the bob · release to swing');const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='▶ Start';}

    function toggle(){
        running=!running;
        const btn=document.querySelector('.sim-launch-btn');
        if(btn)btn.textContent=running?'⏸ Pause':'▶ Start';
        if(running)startSimLoop();
    }

    function touch(type,x,y){
        const b=bobPos();
        if(type==='start'){
            const d=Math.hypot(x-b.x,y-b.y);
            if(d<36){dragging=true;running=false;omega=0;const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='▶ Start';}
        } else if(type==='move'&&dragging){
            angle=Math.atan2(x-pivX(),y-pivY());
            trail=[];draw();
        } else if(type==='end'&&dragging){
            dragging=false;running=true;
            const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='⏸ Pause';
            startSimLoop();
        }
    }

    function tick(){
        if(!running)return;
        const lenFrac=parseFloat(document.getElementById('sim-plen').value)||70;
        const L=(lenFrac/100)*2.5;
        const damp=parseFloat(document.getElementById('sim-damp').value)||1;
        const g=9.81, dt=0.016;
        const alpha=-g/L*Math.sin(angle)-(damp/100)*omega;
        omega+=alpha*dt; angle+=omega*dt; t+=dt;
        trail.push(angle); if(trail.length>90)trail.shift();
        const T=2*Math.PI*Math.sqrt(L/g);
        setStat(chip('Period',T.toFixed(3)+' s')+chip('Angle',(angle*180/Math.PI).toFixed(1)+'°')+chip('ω',omega.toFixed(3)+' r/s'));
        draw();
    }

    function draw(){
        const ctx=simCtx; drawSimBG();
        const L=len(), pX=pivX(), pY=pivY();
        const b=bobPos();

        // ghost trail of bob positions
        trail.forEach((a,i)=>{
            const frac=i/trail.length;
            const tx=pX+Math.sin(a)*L, ty=pY+Math.cos(a)*L;
            ctx.save(); ctx.globalAlpha=frac*0.3;
            ctx.shadowColor='#38bdf8'; ctx.shadowBlur=6;
            ctx.beginPath(); ctx.arc(tx,ty,5*frac,0,Math.PI*2);
            ctx.fillStyle='#38bdf8'; ctx.fill(); ctx.restore();
        });

        // rope with glow
        ctx.save();
        ctx.shadowColor='rgba(255,255,255,0.15)'; ctx.shadowBlur=4;
        ctx.strokeStyle='rgba(255,255,255,0.25)'; ctx.lineWidth=2; ctx.lineCap='round';
        ctx.beginPath(); ctx.moveTo(pX,pY); ctx.lineTo(b.x,b.y); ctx.stroke();
        ctx.restore();

        // pivot
        ctx.save();
        ctx.shadowColor='rgba(255,255,255,0.4)'; ctx.shadowBlur=10;
        ctx.fillStyle='rgba(255,255,255,0.4)';
        ctx.beginPath(); ctx.arc(pX,pY,5,0,Math.PI*2); ctx.fill();
        ctx.restore();

        // angle arc
        ctx.save(); ctx.strokeStyle='rgba(251,146,60,0.25)'; ctx.lineWidth=1;
        ctx.beginPath(); ctx.arc(pX,pY,40,Math.PI/2-angle,Math.PI/2,angle<0); ctx.stroke();
        ctx.restore();

        // bob
        glowCircle(ctx,b.x,b.y,18,'#1d4ed8','#38bdf8',running?24:14);
        // shine dot
        ctx.save(); ctx.fillStyle='rgba(255,255,255,0.45)';
        ctx.beginPath(); ctx.arc(b.x-5,b.y-5,5,0,Math.PI*2); ctx.fill(); ctx.restore();

        // drag hint ring
        if(!running){
            ctx.save(); ctx.strokeStyle='rgba(56,189,248,0.25)'; ctx.lineWidth=1.5; ctx.setLineDash([3,5]);
            ctx.beginPath(); ctx.arc(b.x,b.y,28,0,Math.PI*2); ctx.stroke(); ctx.restore();
        }
    }

    return{init,reset,toggle,tick,touch,get running(){return running;},draw};
})();

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  SPRING — drag mass up/down
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SIM.spring=(()=>{
    let y, vy=0, running=false, trail=[], dragging=false;
    const cx=()=>W()/2, anchorY=36, restY=()=>H()*0.55;

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass (kg)</span><input type="range" class="sim-slider" id="sim-mass" min="0.5" max="10" step="0.5" value="2" oninput="document.getElementById('sv-mass').textContent=this.value+' kg';refreshSliders()"><span class="sim-val" id="sv-mass">2 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Spring k</span><input type="range" class="sim-slider" id="sim-k" min="5" max="100" value="30" oninput="document.getElementById('sv-k').textContent=this.value;refreshSliders()"><span class="sim-val" id="sv-k">30</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.spring.toggle()">▶ Start</button><button class="sim-reset-btn" onclick="SIM.spring.reset()">Reset</button></div>`;
        setTimeout(refreshSliders,10);
    }

    function init(){buildControls();y=restY()+60;vy=0;running=false;trail=[];draw();setHint('✦ drag the mass to pull · release to bounce');}
    function reset(){stopSimLoop();running=false;y=restY()+60;vy=0;trail=[];setStat('');draw();setHint('✦ drag the mass to pull · release to bounce');const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='▶ Start';}

    function toggle(){
        running=!running;
        const btn=document.querySelector('.sim-launch-btn');
        if(btn)btn.textContent=running?'⏸ Pause':'▶ Start';
        if(running)startSimLoop();
    }

    function touch(type,x,y_){
        const bh=44;
        if(type==='start'){if(Math.abs(x-cx())<bh&&Math.abs(y_-(y-bh/2))<bh){dragging=true;running=false;vy=0;const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='▶ Start';}}
        else if(type==='move'&&dragging){y=Math.max(anchorY+30,Math.min(H()-20,y_));trail=[];draw();}
        else if(type==='end'&&dragging){dragging=false;running=true;const btn=document.querySelector('.sim-launch-btn');if(btn)btn.textContent='⏸ Pause';startSimLoop();}
    }

    function tick(){
        if(!running)return;
        const k=parseFloat(document.getElementById('sim-k').value)||30;
        const m=parseFloat(document.getElementById('sim-mass').value)||2;
        const g=9.81, dt=0.016, damp=0.006;
        const disp=y-restY();
        const a=(-k*disp)/m+g-damp*vy;
        vy+=a*dt; y+=vy*dt; trail.push(y);
        if(trail.length>130)trail.shift();
        const freq=1/(2*Math.PI)*Math.sqrt(k/m);
        const period=2*Math.PI*Math.sqrt(m/k);
        setStat(chip('f',freq.toFixed(3)+' Hz')+chip('T',period.toFixed(3)+' s')+chip('disp',disp.toFixed(1)+' px'));
        draw();
    }

    function draw(){
        const ctx=simCtx; drawSimBG();
        const X=cx();

        // equilibrium line
        ctx.save(); ctx.strokeStyle='rgba(167,139,250,0.15)'; ctx.lineWidth=1; ctx.setLineDash([4,7]);
        ctx.beginPath(); ctx.moveTo(X-50,restY()); ctx.lineTo(X+50,restY()); ctx.stroke();
        ctx.setLineDash([]); ctx.restore();
        ctx.save(); ctx.fillStyle='rgba(167,139,250,0.25)'; ctx.font='9px system-ui'; ctx.textAlign='left';
        ctx.fillText('eq',X+14,restY()+4); ctx.restore();

        // spring coils
        const coils=14, springTop=anchorY, springBot=y-22;
        const step=(springBot-springTop)/coils;
        const coilW=Math.max(12,Math.min(28,22-(Math.abs(y-restY())/8)));
        ctx.save();
        ctx.shadowColor='rgba(167,139,250,0.5)'; ctx.shadowBlur=6;
        ctx.strokeStyle='rgba(167,139,250,0.7)'; ctx.lineWidth=2; ctx.lineCap='round';
        ctx.beginPath(); ctx.moveTo(X,springTop);
        for(let i=0;i<=coils;i++){const cy=springTop+i*step;ctx.lineTo(X+(i%2===0?coilW:-coilW),cy);}
        ctx.lineTo(X,springBot); ctx.stroke(); ctx.restore();

        // anchor bar
        ctx.save(); ctx.fillStyle='rgba(255,255,255,0.12)';
        ctx.beginPath(); ctx.roundRect(X-24,anchorY-8,48,8,4); ctx.fill(); ctx.restore();

        // trail (right side)
        trail.forEach((ty,i)=>{
            const a=i/trail.length;
            ctx.save(); ctx.globalAlpha=a*0.4; ctx.shadowColor='#a78bfa'; ctx.shadowBlur=4;
            ctx.fillStyle='#a78bfa';
            ctx.beginPath(); ctx.arc(X-42,ty,2.5,0,Math.PI*2); ctx.fill(); ctx.restore();
        });

        // mass block
        const bw=46, bh=46;
        const m=parseFloat((document.getElementById('sim-mass')||{value:2}).value)||2;
        ctx.save();
        ctx.shadowColor='rgba(167,139,250,0.5)'; ctx.shadowBlur=dragging?20:12;
        const mg=ctx.createLinearGradient(X-bw/2,y-bh,X+bw/2,y);
        mg.addColorStop(0,'rgba(167,139,250,0.5)'); mg.addColorStop(1,'rgba(109,40,217,0.7)');
        ctx.fillStyle=mg;
        ctx.beginPath(); ctx.roundRect(X-bw/2,y-bh,bw,bh,10); ctx.fill();
        ctx.strokeStyle='rgba(167,139,250,0.5)'; ctx.lineWidth=0.8; ctx.stroke();
        ctx.restore();
        ctx.save(); ctx.fillStyle='rgba(255,255,255,0.75)'; ctx.font='bold 11px system-ui'; ctx.textAlign='center';
        ctx.fillText(m+'kg',X,y-bh/2+4); ctx.restore();

        // drag indicator
        if(!running){
            ctx.save(); ctx.strokeStyle='rgba(167,139,250,0.3)'; ctx.lineWidth=1.5; ctx.setLineDash([2,5]);
            ctx.beginPath(); ctx.arc(X,y-bh/2,30,0,Math.PI*2); ctx.stroke(); ctx.restore();
        }
    }

    return{init,reset,toggle,tick,touch};
})();

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  COLLISION — flick balls
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SIM.collision=(()=>{
    let b1,b2,running=false,collided=false,t=0,particles=[];
    let dragging=null,lastDX=0,lastDT=1,prevTouchX=0,prevTouchTime=0;
    const gY=()=>H()-44;

    function mkBall(x,m,col,glc){
        const r=10+m*3.2;
        return{x,y:gY()-r,vx:0,vy:0,m,r,col,glc};
    }

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass 1 (kg)</span><input type="range" class="sim-slider" id="sim-m1" min="1" max="10" value="3" oninput="document.getElementById('sv-m1').textContent=this.value+' kg';SIM.collision.reset();refreshSliders()"><span class="sim-val" id="sv-m1">3 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass 2 (kg)</span><input type="range" class="sim-slider" id="sim-m2" min="1" max="10" value="5" oninput="document.getElementById('sv-m2').textContent=this.value+' kg';SIM.collision.reset();refreshSliders()"><span class="sim-val" id="sv-m2">5 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Restitution</span><input type="range" class="sim-slider" id="sim-res" min="0" max="10" value="8" oninput="document.getElementById('sv-res').textContent=(this.value/10).toFixed(1);refreshSliders()"><span class="sim-val" id="sv-res">0.8</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.collision.launch()">💥 Launch</button><button class="sim-reset-btn" onclick="SIM.collision.reset()">Reset</button></div>`;
        setTimeout(refreshSliders,10);
    }

    function init(){buildControls();reset();}

    function reset(){
        stopSimLoop(); running=false; collided=false; t=0; particles=[];
        const m1=parseFloat((document.getElementById('sim-m1')||{value:3}).value)||3;
        const m2=parseFloat((document.getElementById('sim-m2')||{value:5}).value)||5;
        b1=mkBall(b1?.r||10+m1*3.2+8,m1,'#fb923c','#fb923c');
        b2=mkBall(W()-(10+m2*3.2)-8,m2,'#38bdf8','#38bdf8');
        b1.x=b1.r+8; b2.x=W()-b2.r-8;
        setStat(''); draw();
        setHint('✦ swipe each ball to set speed · tap Launch');
    }

    function launch(){
        running=true; collided=false; t=0; particles=[];
        if(b1.vx===0&&b2.vx===0){b1.vx=110;b2.vx=-40;}
        setHint('');
        startSimLoop();
    }

    function touch(type,x,y){
        if(running){
            // mid-flight nudge: tap left half nudges b1, tap right half nudges b2
            if(type==='start'){
                if(x<W()/2&&Math.abs(y-b1.y)<50){b1.vx+=80;}
                else if(x>=W()/2&&Math.abs(y-b2.y)<50){b2.vx-=80;}
            }
            return;
        }
        if(type==='start'){
            const d1=Math.hypot(x-b1.x,y-b1.y), d2=Math.hypot(x-b2.x,y-b2.y);
            if(d1<b1.r+16){dragging=b1;}
            else if(d2<b2.r+16){dragging=b2;}
            if(dragging){prevTouchX=x;prevTouchTime=Date.now();}
        } else if(type==='move'&&dragging){
            const now=Date.now();
            const dt=Math.max(1,now-prevTouchTime);
            lastDX=x-prevTouchX; lastDT=dt;
            dragging.x=Math.max(dragging.r+4,Math.min(W()-dragging.r-4,x));
            prevTouchX=x; prevTouchTime=now;
            draw();
        } else if(type==='end'&&dragging){
            // velocity from swipe
            dragging.vx=lastDX/lastDT*600;
            dragging=null; lastDX=0;
            draw();
        }
    }

    function spawnParticles(x,y,col){
        for(let i=0;i<20;i++) particles.push({x,y,vx:(Math.random()-0.5)*160,vy:-Math.random()*100-20,life:1,col});
    }

    function tick(){
        if(!running)return;
        const dt=0.016;
        const e=parseFloat(document.getElementById('sim-res').value)/10||0.8;
        [b1,b2].forEach(b=>b.x+=b.vx*dt);
        t+=dt;
        const dist=Math.abs(b2.x-b1.x);
        if(!collided&&dist<=b1.r+b2.r){
            collided=true;
            const u1=b1.vx,u2=b2.vx,m1_=b1.m,m2_=b2.m;
            b1.vx=((m1_-e*m2_)*u1+(1+e)*m2_*u2)/(m1_+m2_);
            b2.vx=((m2_-e*m1_)*u2+(1+e)*m1_*u1)/(m1_+m2_);
            spawnParticles((b1.x+b2.x)/2,(b1.y+b2.y)/2,'#fff');
            tap(); tap(); tap();
        }
        // wall bounce
        if(b1.x-b1.r<0){b1.x=b1.r;b1.vx=Math.abs(b1.vx)*e;}
        if(b2.x+b2.r>W()){b2.x=W()-b2.r;b2.vx=-Math.abs(b2.vx)*e;}
        // update particles
        particles.forEach(p=>{p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=160*dt;p.life-=dt*1.8;});
        particles=particles.filter(p=>p.life>0);
        const KE=(0.5*b1.m*b1.vx*b1.vx+0.5*b2.m*b2.vx*b2.vx)/3600;
        const p=(b1.m*b1.vx+b2.m*b2.vx)/60;
        setStat(chip('v₁',(b1.vx/60).toFixed(2)+' m/s')+chip('v₂',(b2.vx/60).toFixed(2)+' m/s')+chip('KE',KE.toFixed(3)+' J')+chip('p',p.toFixed(3)+' kg·m/s'));
        draw();
    }

    function drawBall(b){
        const ctx=simCtx;
        // velocity arrow
        if(Math.abs(b.vx)>5||!running){
            const spd=running?b.vx:b.vx;
            const dir=Math.sign(spd); const alen=Math.min(Math.abs(spd)*0.28,55);
            if(Math.abs(spd)>3){
                ctx.save(); ctx.strokeStyle=b.col+'99'; ctx.lineWidth=2;
                ctx.beginPath(); ctx.moveTo(b.x,b.y); ctx.lineTo(b.x+dir*alen,b.y); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(b.x+dir*alen,b.y); ctx.lineTo(b.x+dir*(alen-7),b.y-5); ctx.lineTo(b.x+dir*(alen-7),b.y+5); ctx.closePath(); ctx.fillStyle=b.col+'99'; ctx.fill();
                ctx.restore();
            }
        }
        glowCircle(ctx,b.x,b.y,b.r,b.col,b.glc,collided&&running?20:14);
        ctx.save(); ctx.fillStyle='rgba(255,255,255,0.8)'; ctx.font=`bold ${Math.max(9,b.r*0.52)}px system-ui`; ctx.textAlign='center';
        ctx.fillText(b.m+'kg',b.x,b.y+4); ctx.restore();
        // drag ring
        if(!running&&!dragging){
            ctx.save(); ctx.strokeStyle=b.col+'40'; ctx.lineWidth=1.5; ctx.setLineDash([2,5]);
            ctx.beginPath(); ctx.arc(b.x,b.y,b.r+12,0,Math.PI*2); ctx.stroke(); ctx.restore();
        }
    }

    function draw(){
        drawSimBG(); drawGround(gY());
        particles.forEach(p=>{
            simCtx.save(); simCtx.globalAlpha=p.life;
            simCtx.shadowColor='#fff'; simCtx.shadowBlur=8;
            simCtx.fillStyle=`rgba(255,255,255,${p.life})`;
            simCtx.beginPath(); simCtx.arc(p.x,p.y,3*p.life,0,Math.PI*2); simCtx.fill(); simCtx.restore();
        });
        if(b1)drawBall(b1);
        if(b2)drawBall(b2);
    }

    return{init,reset,launch,tick,touch};
})();
</script>
