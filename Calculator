let simCanvas,simCtx,simRAF=null,simScene='projectile';
const SIM={};

function initSim(){
    simCanvas=document.getElementById('sim-canvas');
    const wrap=simCanvas.parentElement;
    simCanvas.width=wrap.offsetWidth;
    simCanvas.height=wrap.offsetHeight;
    simCtx=simCanvas.getContext('2d');
    selectScene('projectile');
}

function startSimLoop(){if(simRAF)return;SIM[simScene]&&SIM[simScene].loop&&simLoop();}
function stopSimLoop(){if(simRAF){cancelAnimationFrame(simRAF);simRAF=null;}}
function simLoop(){simRAF=requestAnimationFrame(simLoop);SIM[simScene]&&SIM[simScene].tick&&SIM[simScene].tick();}

function selectScene(name){
    tap();
    stopSimLoop();
    simScene=name;
    document.querySelectorAll('.sim-scene-btn').forEach((b,i)=>{
        const names=['projectile','pendulum','spring','collision'];
        b.classList.toggle('active',names[i]===name);
    });
    if(!simCanvas)return;
    simCtx.clearRect(0,0,simCanvas.width,simCanvas.height);
    document.getElementById('sim-stats').innerHTML='';
    SIM[name].init();
}

function setStat(html){document.getElementById('sim-stats').innerHTML=html;}
function statLine(label,val){return`<div class="sim-stat">${label}: ${val}</div>`;}

const W=()=>simCanvas.width, H=()=>simCanvas.height;
const clr=()=>{ simCtx.fillStyle='rgba(4,4,12,0.88)'; simCtx.fillRect(0,0,W(),H()); };

// ── ground line helper ──
function drawGround(y){
    const ctx=simCtx;
    ctx.strokeStyle='rgba(255,255,255,0.12)';ctx.lineWidth=1;
    ctx.setLineDash([4,6]);ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W(),y);ctx.stroke();ctx.setLineDash([]);
}

// ━━━━━━━━ PROJECTILE ━━━━━━━━
SIM.projectile=(()=>{
    let px,py,vx,vy,running=false,trail=[],maxH=0,range=0,t=0;
    const g=9.81,scale=4;
    const ground=()=>H()-40;

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Angle (°)</span><input type="range" class="sim-slider" id="sim-angle" min="5" max="85" value="45" oninput="document.getElementById('sv-angle').textContent=this.value+'°';"/><span class="sim-val" id="sv-angle">45°</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Speed (m/s)</span><input type="range" class="sim-slider" id="sim-speed" min="5" max="50" value="20" oninput="document.getElementById('sv-speed').textContent=this.value+' m/s';"/><span class="sim-val" id="sv-speed">20 m/s</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Gravity (m/s²)</span><input type="range" class="sim-slider" id="sim-grav" min="1" max="25" value="10" oninput="document.getElementById('sv-grav').textContent=this.value+' m/s²';"/><span class="sim-val" id="sv-grav">10 m/s²</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.projectile.launch()">🚀 Launch</button><button class="sim-reset-btn" onclick="SIM.projectile.reset()">Reset</button></div>`;
    }

    function init(){buildControls();reset();}

    function reset(){
        running=false;trail=[];maxH=0;range=0;t=0;
        px=30;py=ground();vx=0;vy=0;
        draw();setStat('');
    }

    function launch(){
        const angle=parseFloat(document.getElementById('sim-angle').value)*Math.PI/180;
        const speed=parseFloat(document.getElementById('sim-speed').value);
        const grav=parseFloat(document.getElementById('sim-grav').value)||9.81;
        px=30;py=ground();trail=[];maxH=0;range=0;t=0;
        vx=speed*Math.cos(angle)*scale;
        vy=-speed*Math.sin(angle)*scale;
        running=true;
        startSimLoop();
    }

    let lastT=0,grav=10;
    function tick(){
        if(!running)return;
        grav=parseFloat(document.getElementById('sim-grav').value)||10;
        const dt=0.016;
        vy+=grav*scale*dt;
        px+=vx*dt;
        py+=vy*dt;
        t+=dt;
        trail.push({x:px,y:py});
        if(trail.length>300)trail.shift();
        const curH=(ground()-py)/scale;
        if(curH>maxH)maxH=curH;
        if(py>=ground()){
            py=ground();running=false;
            range=(px-30)/scale;
            setStat(statLine('Max height',maxH.toFixed(1)+' m')+statLine('Range',range.toFixed(1)+' m')+statLine('Time',t.toFixed(2)+' s'));
        }
        draw();
        if(running)setStat(statLine('Height',(Math.max(0,(ground()-py)/scale)).toFixed(1)+' m')+statLine('Speed',(Math.sqrt(vx*vx+vy*vy)/scale).toFixed(1)+' m/s')+statLine('Time',t.toFixed(2)+' s'));
    }

    function draw(){
        const ctx=simCtx; clr();
        drawGround(ground());
        // trajectory preview (dashed)
        const ang=parseFloat((document.getElementById('sim-angle')||{value:45}).value)*Math.PI/180;
        const spd=parseFloat((document.getElementById('sim-speed')||{value:20}).value);
        const grv=parseFloat((document.getElementById('sim-grav')||{value:10}).value)||10;
        ctx.strokeStyle='rgba(251,146,60,0.15)';ctx.lineWidth=1;ctx.setLineDash([3,5]);
        ctx.beginPath();let sx=30,sy=ground(),svx=spd*Math.cos(ang)*scale,svy=-spd*Math.sin(ang)*scale;
        ctx.moveTo(sx,sy);
        for(let i=0;i<200;i++){svy+=grv*scale*0.016;sx+=svx*0.016;sy+=svy*0.016;if(sy>=ground())break;ctx.lineTo(sx,sy);}
        ctx.stroke();ctx.setLineDash([]);
        // trail
        if(trail.length>1){
            ctx.beginPath();ctx.moveTo(trail[0].x,trail[0].y);
            for(let i=1;i<trail.length;i++){
                const a=i/trail.length;
                ctx.strokeStyle=`rgba(251,146,60,${a*0.8})`;ctx.lineWidth=2;
                ctx.lineTo(trail[i].x,trail[i].y);ctx.stroke();ctx.beginPath();ctx.moveTo(trail[i].x,trail[i].y);
            }
        }
        // ball
        ctx.beginPath();ctx.arc(px,py,8,0,Math.PI*2);
        ctx.fillStyle=running?'#fb923c':'#fbbf24';ctx.fill();
        ctx.strokeStyle='rgba(255,255,255,0.3)';ctx.lineWidth=1;ctx.stroke();
        // launch arrow
        if(!running&&trail.length===0){
            const ang2=parseFloat((document.getElementById('sim-angle')||{value:45}).value)*Math.PI/180;
            ctx.strokeStyle='rgba(251,146,60,0.5)';ctx.lineWidth=2;
            ctx.beginPath();ctx.moveTo(30,ground());ctx.lineTo(30+Math.cos(ang2)*30,ground()-Math.sin(ang2)*30);ctx.stroke();
        }
    }

    return{init,reset,launch,tick};
})();

// ━━━━━━━━ PENDULUM ━━━━━━━━
SIM.pendulum=(()=>{
    let angle,omega=0,running=false,trail=[],t=0;

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Length (m)</span><input type="range" class="sim-slider" id="sim-len" min="1" max="5" step="0.1" value="2" oninput="document.getElementById('sv-len').textContent=this.value+' m';if(!SIM.pendulum.running)SIM.pendulum.draw();"/><span class="sim-val" id="sv-len">2 m</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Start angle (°)</span><input type="range" class="sim-slider" id="sim-pang" min="5" max="80" value="30" oninput="document.getElementById('sv-pang').textContent=this.value+'°';SIM.pendulum.setAngle();"/><span class="sim-val" id="sv-pang">30°</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Damping</span><input type="range" class="sim-slider" id="sim-damp" min="0" max="5" step="0.1" value="0.5" oninput="document.getElementById('sv-damp').textContent=this.value;"/><span class="sim-val" id="sv-damp">0.5</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.pendulum.toggle()">▶ Start</button><button class="sim-reset-btn" onclick="SIM.pendulum.reset()">Reset</button></div>`;
        setAngle();
    }

    function setAngle(){angle=parseFloat((document.getElementById('sim-pang')||{value:30}).value)*Math.PI/180;omega=0;draw();}
    function init(){buildControls();setAngle();}
    function reset(){running=false;omega=0;trail=[];t=0;setAngle();document.querySelector('.sim-launch-btn').textContent='▶ Start';setStat('');}

    function toggle(){
        running=!running;
        document.querySelector('.sim-launch-btn').textContent=running?'⏸ Pause':'▶ Start';
        if(running)startSimLoop();
    }

    function tick(){
        if(!running)return;
        const L=parseFloat(document.getElementById('sim-len').value)||2;
        const damp=parseFloat(document.getElementById('sim-damp').value)||0;
        const g=9.81,dt=0.016;
        const alpha=-g/L*Math.sin(angle)-damp/100*omega;
        omega+=alpha*dt;angle+=omega*dt;t+=dt;
        trail.push(angle);if(trail.length>80)trail.shift();
        const T=2*Math.PI*Math.sqrt(L/g);
        setStat(statLine('Period',T.toFixed(3)+' s')+statLine('Angle',(angle*180/Math.PI).toFixed(1)+'°')+statLine('ω',omega.toFixed(3)+' rad/s'));
        draw();
    }

    function draw(){
        const ctx=simCtx; clr();
        const L=parseFloat((document.getElementById('sim-len')||{value:2}).value);
        const pxLen=Math.min(H()*0.55,W()*0.55);
        const ox=W()/2,oy=30;
        const bx=ox+Math.sin(angle)*pxLen,by=oy+Math.cos(angle)*pxLen;
        // trail
        if(trail.length>1){
            for(let i=1;i<trail.length;i++){
                const a=i/trail.length;
                const tx2=ox+Math.sin(trail[i])*pxLen,ty2=oy+Math.cos(trail[i])*pxLen;
                ctx.beginPath();ctx.arc(tx2,ty2,3,0,Math.PI*2);
                ctx.fillStyle=`rgba(56,189,248,${a*0.35})`;ctx.fill();
            }
        }
        // rod
        ctx.strokeStyle='rgba(255,255,255,0.3)';ctx.lineWidth=2;
        ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(bx,by);ctx.stroke();
        // pivot
        ctx.beginPath();ctx.arc(ox,oy,5,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,0.5)';ctx.fill();
        // bob
        const r=16;
        ctx.beginPath();ctx.arc(bx,by,r,0,Math.PI*2);
        const grad=ctx.createRadialGradient(bx-4,by-4,2,bx,by,r);
        grad.addColorStop(0,'#93c5fd');grad.addColorStop(1,'#1d4ed8');
        ctx.fillStyle=grad;ctx.fill();
        ctx.strokeStyle='rgba(255,255,255,0.25)';ctx.lineWidth=1;ctx.stroke();
        // angle arc
        ctx.strokeStyle='rgba(251,146,60,0.3)';ctx.lineWidth=1;
        ctx.beginPath();ctx.arc(ox,oy,50,Math.PI/2-angle,Math.PI/2,angle<0);ctx.stroke();
    }

    return{init,reset,toggle,tick,setAngle,get running(){return running;}};
})();

// ━━━━━━━━ SPRING ━━━━━━━━
SIM.spring=(()=>{
    let y,vy=0,running=false,t=0,trail=[];
    const restY=()=>H()*0.55,mass=()=>parseFloat(document.getElementById('sim-mass')||{value:1}).value||1;

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass (kg)</span><input type="range" class="sim-slider" id="sim-mass" min="0.5" max="10" step="0.5" value="2" oninput="document.getElementById('sv-mass').textContent=this.value+' kg';"/><span class="sim-val" id="sv-mass">2 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Spring k (N/m)</span><input type="range" class="sim-slider" id="sim-k" min="5" max="100" value="30" oninput="document.getElementById('sv-k').textContent=this.value+' N/m';"/><span class="sim-val" id="sv-k">30 N/m</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Pull down (m)</span><input type="range" class="sim-slider" id="sim-pull" min="20" max="100" value="50" oninput="document.getElementById('sv-pull').textContent=this.value+'px';"/><span class="sim-val" id="sv-pull">50px</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.spring.toggle()">▶ Start</button><button class="sim-reset-btn" onclick="SIM.spring.reset()">Reset</button></div>`;
        reset();
    }

    function init(){buildControls();}
    function reset(){running=false;const pull=parseFloat((document.getElementById('sim-pull')||{value:50}).value)||50;y=restY()+pull;vy=0;t=0;trail=[];document.querySelector&&(document.querySelector('.sim-launch-btn').textContent='▶ Start');draw();setStat('');}

    function toggle(){running=!running;document.querySelector('.sim-launch-btn').textContent=running?'⏸ Pause':'▶ Start';if(running)startSimLoop();}

    function tick(){
        if(!running)return;
        const k=parseFloat(document.getElementById('sim-k').value)||30;
        const m=parseFloat(document.getElementById('sim-mass').value)||2;
        const g=9.81,dt=0.016,damp=0.005;
        const disp=y-restY();
        const a=(-k*disp)/m+g-damp*vy;
        vy+=a*dt;y+=vy*dt;t+=dt;
        trail.push(y);if(trail.length>120)trail.shift();
        const freq=1/(2*Math.PI)*Math.sqrt(k/m);
        const period=2*Math.PI*Math.sqrt(m/k);
        setStat(statLine('Frequency',freq.toFixed(3)+' Hz')+statLine('Period',period.toFixed(3)+' s')+statLine('Displacement',(disp).toFixed(1)+' px'));
        draw();
    }

    function draw(){
        const ctx=simCtx; clr();
        const cx=W()/2;
        const anchorY=40;
        // spring coils
        const coils=12,coilW=24;
        const springTop=anchorY,springBot=y-16;
        const step=(springBot-springTop)/coils;
        ctx.strokeStyle='rgba(167,139,250,0.7)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(cx,springTop);
        for(let i=0;i<=coils;i++){const cy2=springTop+i*step;ctx.lineTo(cx+(i%2===0?coilW:-coilW),cy2);}
        ctx.lineTo(cx,springBot);ctx.stroke();
        // anchor
        ctx.fillStyle='rgba(255,255,255,0.2)';ctx.fillRect(cx-20,anchorY-6,40,6);
        // trail dots
        trail.forEach((ty,i)=>{const a=i/trail.length;ctx.beginPath();ctx.arc(cx-36,ty,2,0,Math.PI*2);ctx.fillStyle=`rgba(167,139,250,${a*0.5})`;ctx.fill();});
        // equilibrium line
        ctx.strokeStyle='rgba(255,255,255,0.1)';ctx.setLineDash([4,6]);ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(cx-60,restY());ctx.lineTo(cx+60,restY());ctx.stroke();ctx.setLineDash([]);
        ctx.fillStyle='rgba(255,255,255,0.2)';ctx.font='9px system-ui';ctx.textAlign='left';ctx.fillText('equilibrium',cx+12,restY()+4);
        // mass block
        const bw=44,bh=44;
        const grd=ctx.createLinearGradient(cx-bw/2,y-bh,cx+bw/2,y);
        grd.addColorStop(0,'rgba(167,139,250,0.4)');grd.addColorStop(1,'rgba(109,40,217,0.6)');
        ctx.fillStyle=grd;ctx.beginPath();ctx.roundRect(cx-bw/2,y-bh,bw,bh,8);ctx.fill();
        ctx.strokeStyle='rgba(167,139,250,0.4)';ctx.lineWidth=1;ctx.stroke();
        ctx.fillStyle='rgba(255,255,255,0.7)';ctx.font='11px system-ui';ctx.textAlign='center';
        ctx.fillText(parseFloat((document.getElementById('sim-mass')||{value:2}).value)+' kg',cx,y-bh/2+4);
    }

    return{init,reset,toggle,tick};
})();

// ━━━━━━━━ COLLISION ━━━━━━━━
SIM.collision=(()=>{
    let b1,b2,running=false,collided=false,t=0;
    const groundY=()=>H()-50;

    function buildControls(){
        document.getElementById('sim-controls').innerHTML=`
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass 1 (kg)</span><input type="range" class="sim-slider" id="sim-m1" min="1" max="10" value="3" oninput="document.getElementById('sv-m1').textContent=this.value+' kg';SIM.collision.reset();"/><span class="sim-val" id="sv-m1">3 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Mass 2 (kg)</span><input type="range" class="sim-slider" id="sim-m2" min="1" max="10" value="5" oninput="document.getElementById('sv-m2').textContent=this.value+' kg';SIM.collision.reset();"/><span class="sim-val" id="sv-m2">5 kg</span></div>
        <div class="sim-ctrl-row"><span class="sim-ctrl-label">Restitution</span><input type="range" class="sim-slider" id="sim-res" min="0" max="10" value="8" oninput="document.getElementById('sv-res').textContent=(this.value/10).toFixed(1);"/><span class="sim-val" id="sv-res">0.8</span></div>
        <div class="sim-btn-row"><button class="sim-launch-btn" onclick="SIM.collision.launch()">💥 Launch</button><button class="sim-reset-btn" onclick="SIM.collision.reset()">Reset</button></div>`;
        reset();
    }

    function init(){buildControls();}

    function reset(){
        running=false;collided=false;t=0;
        const m1=parseFloat((document.getElementById('sim-m1')||{value:3}).value)||3;
        const m2=parseFloat((document.getElementById('sim-m2')||{value:5}).value)||5;
        const r1=10+m1*3,r2=10+m2*3;
        b1={x:r1+10,y:groundY()-r1,vx:0,vy:0,m:m1,r:r1,col:'#fb923c'};
        b2={x:W()-r2-10,y:groundY()-r2,vx:0,vy:0,m:m2,r:r2,col:'#38bdf8'};
        draw();setStat('');
    }

    function launch(){
        running=true;collided=false;t=0;
        const m1=parseFloat(document.getElementById('sim-m1').value)||3;
        const m2=parseFloat(document.getElementById('sim-m2').value)||5;
        const r1=10+m1*3,r2=10+m2*3;
        b1={x:r1+10,y:groundY()-r1,vx:120,vy:0,m:m1,r:r1,col:'#fb923c'};
        b2={x:W()-r2-10,y:groundY()-r2,vx:-40,vy:0,m:m2,r:r2,col:'#38bdf8'};
        startSimLoop();
    }

    function tick(){
        if(!running)return;
        const dt=0.016,e=parseFloat(document.getElementById('sim-res').value)/10||0.8;
        [b1,b2].forEach(b=>{b.x+=b.vx*dt;});
        t+=dt;
        const dx=b2.x-b1.x,dist=Math.abs(dx);
        if(!collided&&dist<=b1.r+b2.r){
            collided=true;
            const u1=b1.vx,u2=b2.vx,m1=b1.m,m2=b2.m;
            b1.vx=((m1-e*m2)*u1+(1+e)*m2*u2)/(m1+m2);
            b2.vx=((m2-e*m1)*u2+(1+e)*m1*u1)/(m1+m2);
        }
        // wall bounce
        if(b1.x-b1.r<0){b1.x=b1.r;b1.vx=Math.abs(b1.vx)*e;}
        if(b2.x+b2.r>W()){b2.x=W()-b2.r;b2.vx=-Math.abs(b2.vx)*e;}
        const KE1=0.5*b1.m*b1.vx*b1.vx,KE2=0.5*b2.m*b2.vx*b2.vx;
        const p1=b1.m*b1.vx,p2=b2.m*b2.vx;
        setStat(statLine('v₁',(b1.vx/60).toFixed(2)+' m/s')+statLine('v₂',(b2.vx/60).toFixed(2)+' m/s')+statLine('KE total',((KE1+KE2)/3600).toFixed(3)+' J')+statLine('Momentum',((p1+p2)/60).toFixed(3)+' kg·m/s'));
        draw();
    }

    function drawBall(b){
        const ctx=simCtx;
        const grd=ctx.createRadialGradient(b.x-b.r*0.3,b.y-b.r*0.3,b.r*0.1,b.x,b.y,b.r);
        grd.addColorStop(0,'rgba(255,255,255,0.4)');grd.addColorStop(1,b.col);
        ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.fillStyle=grd;ctx.fill();
        ctx.strokeStyle='rgba(255,255,255,0.2)';ctx.lineWidth=1;ctx.stroke();
        ctx.fillStyle='rgba(255,255,255,0.85)';ctx.font=`${Math.max(9,b.r*0.55)}px system-ui`;ctx.textAlign='center';
        ctx.fillText(b.m+'kg',b.x,b.y+4);
        // velocity arrow
        if(Math.abs(b.vx)>5){
            const dir=Math.sign(b.vx),alen=Math.min(Math.abs(b.vx)*0.3,50);
            ctx.strokeStyle=b.col;ctx.lineWidth=2;
            ctx.beginPath();ctx.moveTo(b.x,b.y);ctx.lineTo(b.x+dir*alen,b.y);ctx.stroke();
            ctx.beginPath();ctx.moveTo(b.x+dir*alen,b.y);ctx.lineTo(b.x+dir*(alen-8),b.y-5);ctx.lineTo(b.x+dir*(alen-8),b.y+5);ctx.closePath();ctx.fillStyle=b.col;ctx.fill();
        }
    }

    function draw(){
        clr();drawGround(groundY());
        if(b1)drawBall(b1);
        if(b2)drawBall(b2);
        if(collided){
            simCtx.fillStyle='rgba(255,255,255,0.15)';simCtx.font='11px system-ui';simCtx.textAlign='center';
            simCtx.fillText('COLLISION',W()/2,30);
        }
    }

    return{init,reset,launch,tick};
})();

</script>
