<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#050508">
    <title>Smart Calculator</title>
    <style>
        :root {
            --text: rgba(255,255,255,0.92);
            --muted: rgba(255,255,255,0.28);
            --accent: rgba(255,255,255,0.55);
            --blue: #38bdf8;
        }
        * { box-sizing:border-box; margin:0; padding:0; font-family:-apple-system,'SF Pro Display',system-ui,sans-serif; -webkit-tap-highlight-color:transparent; }

        body {
            background:
                radial-gradient(ellipse at 30% 20%, rgba(99,102,241,0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 75% 75%, rgba(52,211,153,0.07) 0%, transparent 55%),
                radial-gradient(ellipse at 10% 80%, rgba(168,85,247,0.08) 0%, transparent 50%),
                #050508;
            background-attachment:fixed;
            color:var(--text); height:100vh;
            display:flex; justify-content:center; align-items:center; overflow:hidden;
        }

        .calc-app {
            width:100vw; height:100vh; max-width:480px;
            padding:14px; display:flex; flex-direction:column; gap:9px;
        }

        /* Top bar */
        .top-bar { display:flex; justify-content:space-between; align-items:center; height:32px; flex-shrink:0; }

        .deg-toggle {
            background:rgba(255,255,255,0.06); border:0.5px solid rgba(56,189,248,0.3);
            color:var(--blue); padding:5px 14px; border-radius:20px;
            font-size:0.72rem; font-weight:600; letter-spacing:0.08em;
            box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.12);
        }
        .tape-btn {
            background:rgba(255,255,255,0.06); border:0.5px solid rgba(255,255,255,0.1);
            color:var(--muted); padding:5px 14px; border-radius:20px;
            font-size:0.78rem; font-weight:400;
            box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.1);
        }

        /* Screen */
        .screen {
            background:rgba(20,20,35,0.85); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
            border-radius:24px; padding:20px 22px 16px;
            border:0.5px solid rgba(255,255,255,0.1);
            box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.12), 0 20px 40px rgba(0,0,0,0.4);
            display:flex; flex-direction:column; justify-content:flex-end;
            height:118px; flex-shrink:0; cursor:pointer; user-select:none;
        }
        .expr { color:var(--muted); font-size:0.9rem; font-weight:300; text-align:right; min-height:1.2rem; letter-spacing:0.03em; }
        .output { color:var(--text); font-size:2.8rem; font-weight:200; letter-spacing:-0.03em; text-align:right; overflow-x:auto; white-space:nowrap; }
        .copy-hint { font-size:0.62rem; color:rgba(56,189,248,0.5); text-align:right; margin-top:2px; letter-spacing:0.04em; }
        @keyframes flash { 0%,100%{opacity:1} 50%{opacity:0.35} }
        .flashing { animation:flash 0.25s ease; }

        /* Tab bar */
        .tab-bar {
            display:flex; background:rgba(255,255,255,0.04);
            border:0.5px solid rgba(255,255,255,0.07);
            border-radius:14px; padding:3px; gap:2px; flex-shrink:0;
        }
        .tab {
            flex:1; padding:7px; border-radius:11px; border:none; outline:none;
            font-size:0.7rem; font-weight:600; letter-spacing:0.07em;
            color:var(--muted); background:transparent;
            transition:background 0.18s, color 0.18s;
        }
        .tab.active { background:rgba(255,255,255,0.1); color:var(--text); box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.14); }

        /* Panels */
        .panels { flex:1; position:relative; min-height:0; }
        .panel { position:absolute; inset:0; display:flex; flex-direction:column; gap:7px; }
        .panel.hidden { display:none; }

        /* ── CALC PANEL ── */
        .keypad { display:grid; grid-template-columns:repeat(5,1fr); gap:7px; flex:1; }

        button {
            position:relative; overflow:hidden;
            border:0.5px solid rgba(255,255,255,0.08); outline:none;
            font-size:0.98rem; font-weight:300; letter-spacing:0.01em;
            border-radius:18px; color:var(--text);
            display:flex; align-items:center; justify-content:center;
            user-select:none; touch-action:manipulation;
            box-shadow:inset 0 0.5px 0 rgba(255,255,255,0.12), inset 0 -0.5px 0 rgba(0,0,0,0.25), 0 2px 6px rgba(0,0,0,0.3);
            transition:transform 0.08s ease, filter 0.08s ease;
        }
        button::before {
            content:""; position:absolute; top:0; left:8%; right:8%;
            height:0.5px; background:rgba(255,255,255,0.28); pointer-events:none;
        }
        button:active { transform:scale(0.93); filter:brightness(0.7); }

        .b-num   { background:rgba(255,255,255,0.05); }
        .b-op    { background:rgba(255,255,255,0.09); }
        .b-sci   { background:rgba(255,255,255,0.03); color:var(--accent); font-size:0.82rem; }
        .b-clear { background:rgba(180,40,40,0.35); }
        .b-eq    { background:rgba(30,120,80,0.4); grid-column:span 2; font-size:1.3rem; font-weight:300; }

        /* ── GRAPH PANEL ── */
        .graph-row { display:flex; gap:7px; flex-shrink:0; }
        .graph-input {
            flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1);
            border-radius:14px; padding:10px 14px; color:var(--text); font-size:0.9rem;
            outline:none; font-family:inherit;
        }
        .graph-input::placeholder { color:var(--muted); }
        .plot-btn {
            background:rgba(56,189,248,0.15); border:0.5px solid rgba(56,189,248,0.25);
            border-radius:14px; padding:10px 16px; color:var(--blue); font-size:0.85rem; font-weight:500;
        }

        .canvas-wrap {
            flex:1; position:relative; border-radius:18px; overflow:hidden;
            border:0.5px solid rgba(255,255,255,0.07); background:rgba(8,8,18,0.7);
        }
        #graph-canvas { display:block; width:100%; height:100%; }

        .graph-hint {
            position:absolute; top:10px; left:50%; transform:translateX(-50%);
            font-size:0.68rem; color:rgba(255,255,255,0.18); letter-spacing:0.04em; pointer-events:none; white-space:nowrap;
        }
        .zoom-btns {
            position:absolute; bottom:12px; right:12px;
            display:flex; flex-direction:column; gap:6px;
        }
        .zoom-btns button {
            width:36px; height:36px; border-radius:12px;
            background:rgba(255,255,255,0.07); border:0.5px solid rgba(255,255,255,0.1);
            font-size:1rem; color:var(--text);
        }

        /* ── CONVERT PANEL ── */
        .cat-bar {
            display:flex; gap:6px; overflow-x:auto; flex-shrink:0; padding-bottom:2px;
            scrollbar-width:none;
        }
        .cat-bar::-webkit-scrollbar { display:none; }
        .cat-btn {
            flex-shrink:0; padding:6px 14px; border-radius:20px;
            font-size:0.7rem; font-weight:600; letter-spacing:0.05em;
            border:0.5px solid rgba(255,255,255,0.08);
            background:rgba(255,255,255,0.04); color:var(--muted);
        }
        .cat-btn.active { background:rgba(56,189,248,0.14); color:var(--blue); border-color:rgba(56,189,248,0.25); }

        .conv-body { flex:1; display:flex; flex-direction:column; justify-content:center; gap:10px; }
        .conv-row { display:flex; align-items:stretch; gap:8px; }
        .conv-num {
            flex:1; background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1);
            border-radius:14px; padding:14px 16px; color:var(--text); font-size:1.3rem; font-weight:200;
            outline:none; font-family:inherit; text-align:right; min-width:0;
        }
        .conv-num::placeholder { color:var(--muted); }
        .conv-unit {
            background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.1);
            border-radius:14px; padding:0 12px; color:var(--text); font-size:0.88rem;
            outline:none; font-family:inherit; appearance:none; -webkit-appearance:none;
            min-width:75px; text-align:center;
        }
        .swap-btn {
            align-self:center; background:rgba(255,255,255,0.06);
            border:0.5px solid rgba(255,255,255,0.1);
            border-radius:14px; width:44px; height:44px; font-size:1.3rem; flex-shrink:0;
        }
        .conv-result {
            background:rgba(255,255,255,0.03); border:0.5px solid rgba(255,255,255,0.07);
            border-radius:16px; padding:16px 18px; text-align:center;
        }
        .conv-result-label { font-size:0.72rem; color:var(--muted); letter-spacing:0.05em; margin-bottom:4px; }
        .conv-result-val { font-size:1.1rem; font-weight:200; color:var(--text); }

        /* ── TAPE ── */
        .tape {
            position:fixed; top:0; right:-100%;
            width:82%; max-width:320px; height:100%;
            background:rgba(8,8,14,0.94); backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px);
            border-left:0.5px solid rgba(255,255,255,0.08);
            box-shadow:-20px 0 60px rgba(0,0,0,0.7);
            transition:right 0.3s cubic-bezier(0.4,0,0.2,1);
            z-index:100; padding:28px 16px 20px;
            display:flex; flex-direction:column;
        }
        .tape.open { right:0; }
        .tape-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
        .tape-title { font-size:0.75rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--accent); }
        .tape-clear { background:none; border:none; color:rgba(200,60,60,0.8); font-size:0.8rem; }

        .tape-scroll { flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:0; }
        .tape-entry {
            position:relative; padding:10px 14px; margin-left:14px;
            border-left:1px solid rgba(255,255,255,0.07); cursor:pointer;
        }
        .tape-entry::before {
            content:""; position:absolute; left:-4.5px; top:15px;
            width:8px; height:8px; border-radius:50%;
            background:rgba(56,189,248,0.2); border:1px solid rgba(56,189,248,0.3);
        }
        .tape-expr { font-size:0.75rem; color:var(--muted); margin-bottom:2px; }
        .tape-val { font-size:1rem; font-weight:200; color:var(--text); }

        .tape-close {
            margin-top:14px; background:rgba(255,255,255,0.05);
            border:0.5px solid rgba(255,255,255,0.08);
            padding:12px; border-radius:14px; font-size:0.88rem;
        }
    </style>
</head>
<body>
<div class="calc-app">

    <div class="top-bar">
        <button class="deg-toggle" id="deg-btn" onclick="tap();toggleDeg()">DEG</button>
        <button class="tape-btn" onclick="tap();toggleTape()">📋 Tape</button>
    </div>

    <div class="screen" onclick="copyResult()">
        <div class="expr" id="expr"></div>
        <div class="output" id="out">0</div>
        <div class="copy-hint">tap to copy</div>
    </div>

    <div class="tab-bar">
        <button class="tab active" id="tab-calc" onclick="switchTab('calc')">CALC</button>
        <button class="tab" id="tab-graph" onclick="switchTab('graph')">GRAPH</button>
        <button class="tab" id="tab-convert" onclick="switchTab('convert')">CONVERT</button>
    </div>

    <div class="panels">

        <!-- CALC -->
        <div class="panel" id="panel-calc">
            <div class="keypad">
                <button class="b-sci" onclick="tap();addFn('sin')">sin</button>
                <button class="b-sci" onclick="tap();addFn('cos')">cos</button>
                <button class="b-sci" onclick="tap();addFn('tan')">tan</button>
                <button class="b-clear" onclick="tap();clearAll()">AC</button>
                <button class="b-clear" onclick="tap();del()">DEL</button>

                <button class="b-sci" onclick="tap();addFn('asin')">asin</button>
                <button class="b-sci" onclick="tap();addFn('acos')">acos</button>
                <button class="b-sci" onclick="tap();addFn('atan')">atan</button>
                <button class="b-sci" onclick="tap();add('(')">(</button>
                <button class="b-sci" onclick="tap();add(')')">)</button>

                <button class="b-sci" onclick="tap();addFn('log')">log</button>
                <button class="b-sci" onclick="tap();addFn('ln')">ln</button>
                <button class="b-sci" onclick="tap();addFn('sqrt')">√</button>
                <button class="b-sci" onclick="tap();add('^')">x^y</button>
                <button class="b-op"  onclick="tap();add('/')">÷</button>

                <button class="b-num" onclick="tap();add('7')">7</button>
                <button class="b-num" onclick="tap();add('8')">8</button>
                <button class="b-num" onclick="tap();add('9')">9</button>
                <button class="b-sci" onclick="tap();add('%')">%</button>
                <button class="b-op"  onclick="tap();add('*')">×</button>

                <button class="b-num" onclick="tap();add('4')">4</button>
                <button class="b-num" onclick="tap();add('5')">5</button>
                <button class="b-num" onclick="tap();add('6')">6</button>
                <button class="b-sci" onclick="tap();addConst('pi')">π</button>
                <button class="b-op"  onclick="tap();add('-')">−</button>

                <button class="b-num" onclick="tap();add('1')">1</button>
                <button class="b-num" onclick="tap();add('2')">2</button>
                <button class="b-num" onclick="tap();add('3')">3</button>
                <button class="b-sci" onclick="tap();addConst('e')">e</button>
                <button class="b-op"  onclick="tap();add('+')">+</button>

                <button class="b-num" onclick="tap();add('0')">0</button>
                <button class="b-num" onclick="tap();add('.')">.</button>
                <button class="b-sci" onclick="tap();add('!')">x!</button>
                <button class="b-eq"  onclick="tap();calc()">=</button>
            </div>
        </div>

        <!-- GRAPH -->
        <div class="panel hidden" id="panel-graph">
            <div class="graph-row">
                <input class="graph-input" id="fn-input" type="text" value="sin(x)" placeholder="sin(x), x^2, tan(x)…" />
                <button class="plot-btn" onclick="tap();plotGraph()">Plot</button>
            </div>
            <div class="canvas-wrap" id="canvas-wrap">
                <canvas id="graph-canvas"></canvas>
                <div class="graph-hint">drag to pan</div>
                <div class="zoom-btns">
                    <button onclick="tap();zoomGraph(1.3)">+</button>
                    <button onclick="tap();zoomGraph(0.77)">−</button>
                    <button onclick="tap();resetGraph()" style="font-size:0.65rem;letter-spacing:0.04em;">RST</button>
                </div>
            </div>
        </div>

        <!-- CONVERT -->
        <div class="panel hidden" id="panel-convert">
            <div class="cat-bar" id="cat-bar"></div>
            <div class="conv-body">
                <div class="conv-row">
                    <input class="conv-num" id="conv-in" type="number" placeholder="0" oninput="doConvert()" />
                    <select class="conv-unit" id="from-unit" onchange="doConvert()"></select>
                </div>
                <button class="swap-btn" onclick="tap();swapUnits()">⇅</button>
                <div class="conv-row">
                    <input class="conv-num" id="conv-out" type="number" placeholder="0" oninput="doConvertReverse()" />
                    <select class="conv-unit" id="to-unit" onchange="doConvert()"></select>
                </div>
                <div class="conv-result">
                    <div class="conv-result-label">RESULT</div>
                    <div class="conv-result-val" id="conv-label">—</div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Tape drawer -->
<div class="tape" id="tape">
    <div class="tape-header">
        <span class="tape-title">Calculation Tape</span>
        <button class="tape-clear" onclick="tap();clearTape()">Clear</button>
    </div>
    <div class="tape-scroll" id="tape-list"></div>
    <button class="tape-close" onclick="tap();toggleTape()">Close</button>
</div>

<script>
// ══════════════════════════════════════
//  CALC
// ══════════════════════════════════════
let current = '', exprText = '', resetOnNext = false, isDeg = true;
const outEl = document.getElementById('out');
const exprEl = document.getElementById('expr');

function tap() { if (navigator.vibrate) navigator.vibrate(8); }

// DEG/RAD — uses wrapper functions injected into window
function toggleDeg() {
    isDeg = !isDeg;
    document.getElementById('deg-btn').textContent = isDeg ? 'DEG' : 'RAD';
    updateTrigFns();
}

function updateTrigFns() {
    const d = isDeg ? Math.PI / 180 : 1;
    const r = isDeg ? 180 / Math.PI : 1;
    window.__sin  = x => Math.sin(x * d);
    window.__cos  = x => Math.cos(x * d);
    window.__tan  = x => Math.tan(x * d);
    window.__asin = x => Math.asin(x) * r;
    window.__acos = x => Math.acos(x) * r;
    window.__atan = x => Math.atan(x) * r;
}
updateTrigFns();

function add(val) {
    if (resetOnNext) {
        if (['+','-','*','/'].includes(val)) { resetOnNext = false; }
        else { current = ''; resetOnNext = false; }
    }
    current += val; render();
}

function addFn(fn) {
    if (resetOnNext) resetOnNext = false;
    current += fn + '('; render();
}

function addConst(c) {
    if (resetOnNext) { current = ''; resetOnNext = false; }
    current += c === 'pi' ? 'Math.PI' : 'Math.E';
    render();
}

function clearAll() { current = ''; exprText = ''; render(); }

function del() {
    if (resetOnNext) { current = ''; resetOnNext = false; render(); return; }
    current = current.slice(0, -1); render();
}

function render() {
    outEl.textContent = current
        .replace(/Math\.PI/g,'π').replace(/Math\.E/g,'e')
        .replace(/\*/g,'×').replace(/\//g,'÷') || '0';
    exprEl.textContent = exprText;
}

function copyResult() {
    const v = outEl.textContent;
    if (v === '0' || v === 'Error') return;
    tap(); tap();
    if (navigator.clipboard) navigator.clipboard.writeText(v);
    outEl.classList.add('flashing');
    setTimeout(() => outEl.classList.remove('flashing'), 250);
}

function factorial(n) {
    if (n < 0 || !Number.isInteger(n)) return NaN;
    if (n <= 1) return 1;
    let r = 1; for (let i = 2; i <= n; i++) r *= i; return r;
}

function parseMath(str) {
    let p = str
        .replace(/asin\(/g, '__asin(').replace(/acos\(/g, '__acos(').replace(/atan\(/g, '__atan(')
        .replace(/sin\(/g, '__sin(').replace(/cos\(/g, '__cos(').replace(/tan\(/g, '__tan(')
        .replace(/log\(/g, 'Math.log10(').replace(/ln\(/g, 'Math.log(')
        .replace(/sqrt\(/g, 'Math.sqrt(')
        .replace(/\^/g, '**')
        .replace(/(\d+(?:\.\d+)?)%/g, '($1/100)');
    return p.replace(/(\d+)!/g, (_, n) => factorial(parseInt(n)));
}

function calc() {
    if (!current) return;
    try {
        exprText = current.replace(/Math\.PI/g,'π').replace(/Math\.E/g,'e');
        let res = eval(parseMath(current));
        if (typeof res === 'number' && isFinite(res) && !isNaN(res)) {
            res = parseFloat(res.toFixed(10));
            saveTape(exprText, res);
            current = res.toString();
            outEl.textContent = res;
            exprEl.textContent = exprText + ' =';
            resetOnNext = true;
        } else { outEl.textContent = 'Error'; }
    } catch { outEl.textContent = 'Error'; }
}

// ══════════════════════════════════════
//  TAPE
// ══════════════════════════════════════
const tapeListEl = document.getElementById('tape-list');

function toggleTape() { document.getElementById('tape').classList.toggle('open'); }

function saveTape(expr, val) {
    const d = document.createElement('div');
    d.className = 'tape-entry';
    d.innerHTML = `<div class="tape-expr">${expr}</div><div class="tape-val">= ${val}</div>`;
    d.onclick = () => { current = val.toString(); resetOnNext = false; render(); toggleTape(); };
    tapeListEl.prepend(d);
}

function clearTape() { tapeListEl.innerHTML = ''; }

// ══════════════════════════════════════
//  TABS
// ══════════════════════════════════════
function switchTab(name) {
    tap();
    ['calc','graph','convert'].forEach(t => {
        document.getElementById('panel-' + t).classList.toggle('hidden', t !== name);
        document.getElementById('tab-' + t).classList.toggle('active', t === name);
    });
    if (name === 'graph') requestAnimationFrame(initGraph);
    if (name === 'convert') initConvert();
}

// ══════════════════════════════════════
//  GRAPH
// ══════════════════════════════════════
let gCanvas, gCtx, gWrap;
let gScale = 50, gPanX = 0, gPanY = 0, gFn = null, gInited = false;
let gDragging = false, gLastX = 0, gLastY = 0;

function initGraph() {
    gWrap = document.getElementById('canvas-wrap');
    gCanvas = document.getElementById('graph-canvas');
    gCanvas.width = gWrap.offsetWidth;
    gCanvas.height = gWrap.offsetHeight;
    gCtx = gCanvas.getContext('2d');

    if (!gInited) {
        gInited = true;
        gCanvas.addEventListener('touchstart', e => {
            gDragging = true;
            gLastX = e.touches[0].clientX; gLastY = e.touches[0].clientY;
        }, {passive:true});
        gCanvas.addEventListener('touchmove', e => {
            if (!gDragging) return;
            gPanX += e.touches[0].clientX - gLastX;
            gPanY += e.touches[0].clientY - gLastY;
            gLastX = e.touches[0].clientX; gLastY = e.touches[0].clientY;
            drawGraph();
        }, {passive:true});
        gCanvas.addEventListener('touchend', () => gDragging = false, {passive:true});
    }
    plotGraph();
}

function compileGraphFn(str) {
    let e = str
        .replace(/asin\(/g,'Math.asin(').replace(/acos\(/g,'Math.acos(').replace(/atan\(/g,'Math.atan(')
        .replace(/sin\(/g,'Math.sin(').replace(/cos\(/g,'Math.cos(').replace(/tan\(/g,'Math.tan(')
        .replace(/log\(/g,'Math.log10(').replace(/ln\(/g,'Math.log(')
        .replace(/sqrt\(/g,'Math.sqrt(').replace(/abs\(/g,'Math.abs(')
        .replace(/\^/g,'**')
        .replace(/\bpi\b/gi,'Math.PI')
        .replace(/\be\b/g,'Math.E');
    return new Function('x', `"use strict"; try { return (${e}); } catch(_){return NaN;}`);
}

function plotGraph() {
    const s = document.getElementById('fn-input').value.trim();
    if (!s) return;
    try { gFn = compileGraphFn(s); } catch { return; }
    drawGraph();
}

function drawGraph() {
    if (!gCanvas || !gCtx) return;
    const W = gCanvas.width, H = gCanvas.height, ctx = gCtx;
    const ox = W/2 + gPanX, oy = H/2 + gPanY;

    ctx.clearRect(0, 0, W, H);

    // Grid
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    for (let x = ox % gScale; x < W; x += gScale) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
    for (let y = oy % gScale; y < H; y += gScale) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }

    // Axes
    ctx.strokeStyle = 'rgba(255,255,255,0.18)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0,oy); ctx.lineTo(W,oy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(ox,0); ctx.lineTo(ox,H); ctx.stroke();

    // Labels
    ctx.fillStyle = 'rgba(255,255,255,0.22)'; ctx.font = '10px system-ui';
    const u = Math.max(1, Math.round(55 / gScale));
    ctx.textAlign = 'center';
    for (let i = Math.floor((-ox)/gScale)-1; i < (W-ox)/gScale+1; i++) {
        if (i===0 || i%u!==0) continue;
        ctx.fillText(i, ox+i*gScale, oy+13);
    }
    ctx.textAlign = 'right';
    for (let i = Math.floor((-oy)/gScale)-1; i < (H-oy)/gScale+1; i++) {
        if (i===0 || i%u!==0) continue;
        ctx.fillText(-i, ox-5, oy+i*gScale+4);
    }

    // Curve
    if (!gFn) return;
    ctx.strokeStyle = '#38bdf8'; ctx.lineWidth = 2; ctx.lineJoin = 'round';
    ctx.beginPath();
    let started = false, prevPy = null;
    for (let px = 0; px <= W; px++) {
        const x = (px - ox) / gScale;
        const y = gFn(x);
        if (!isFinite(y) || Math.abs(y) > 1e6) { started = false; continue; }
        const py = oy - y * gScale;
        if (!started || (prevPy !== null && Math.abs(py - prevPy) > H)) {
            ctx.moveTo(px, py); started = true;
        } else { ctx.lineTo(px, py); }
        prevPy = py;
    }
    ctx.stroke();
}

function zoomGraph(f) { gScale = Math.max(8, Math.min(250, gScale * f)); drawGraph(); }
function resetGraph()  { gScale = 50; gPanX = 0; gPanY = 0; drawGraph(); }

// ══════════════════════════════════════
//  CONVERT
// ══════════════════════════════════════
const unitMaps = {
    Length: { mm:0.001, cm:0.01, m:1, km:1000, in:0.0254, ft:0.3048, yd:0.9144, mi:1609.344 },
    Weight: { mg:0.000001, g:0.001, kg:1, oz:0.0283495, lb:0.453592, t:1000 },
    Data:   { B:1, KB:1024, MB:1048576, GB:1073741824, TB:1099511627776 },
    Speed:  { 'km/h':1, mph:1.60934, 'm/s':3.6, kn:1.852 },
    Area:   { 'cm²':0.0001, 'm²':1, 'km²':1e6, 'ft²':0.092903, ac:4046.86, ha:10000 },
};

let currentCat = 'Length', convInited = false;

function initConvert() {
    if (convInited) return;
    convInited = true;
    const bar = document.getElementById('cat-bar');
    [...Object.keys(unitMaps), 'Temp'].forEach(cat => {
        const b = document.createElement('button');
        b.className = 'cat-btn' + (cat === currentCat ? ' active' : '');
        b.textContent = cat;
        b.onclick = () => { tap(); selectCat(cat); };
        bar.appendChild(b);
    });
    populateUnits(); doConvert();
}

function selectCat(cat) {
    currentCat = cat;
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.toggle('active', b.textContent === cat));
    populateUnits(); doConvert();
}

function populateUnits() {
    const from = document.getElementById('from-unit');
    const to   = document.getElementById('to-unit');
    from.innerHTML = to.innerHTML = '';
    const list = currentCat === 'Temp' ? ['°C','°F','K'] : Object.keys(unitMaps[currentCat]);
    list.forEach((u, i) => {
        from.innerHTML += `<option value="${u}">${u}</option>`;
        to.innerHTML   += `<option value="${u}"${i===1?' selected':''}>${u}</option>`;
    });
}

function tempConvert(v, f, t) {
    let c = f==='°C' ? v : f==='°F' ? (v-32)*5/9 : v-273.15;
    return t==='°C' ? c : t==='°F' ? c*9/5+32 : c+273.15;
}

function doConvert() {
    const v = parseFloat(document.getElementById('conv-in').value);
    const f = document.getElementById('from-unit').value;
    const t = document.getElementById('to-unit').value;
    if (isNaN(v)) { document.getElementById('conv-out').value=''; document.getElementById('conv-label').textContent='—'; return; }
    const res = currentCat==='Temp' ? tempConvert(v,f,t) : v * unitMaps[currentCat][f] / unitMaps[currentCat][t];
    const rounded = parseFloat(res.toFixed(8));
    document.getElementById('conv-out').value = rounded;
    document.getElementById('conv-label').textContent = `${v} ${f} = ${rounded} ${t}`;
}

function doConvertReverse() {
    const v = parseFloat(document.getElementById('conv-out').value);
    const f = document.getElementById('to-unit').value;
    const t = document.getElementById('from-unit').value;
    if (isNaN(v)) { document.getElementById('conv-in').value=''; return; }
    const res = currentCat==='Temp' ? tempConvert(v,f,t) : v * unitMaps[currentCat][f] / unitMaps[currentCat][t];
    document.getElementById('conv-in').value = parseFloat(res.toFixed(8));
    document.getElementById('conv-label').textContent = `${v} ${f} = ${parseFloat(res.toFixed(8))} ${t}`;
}

function swapUnits() {
    const f = document.getElementById('from-unit'), t = document.getElementById('to-unit');
    [f.value, t.value] = [t.value, f.value]; doConvert();
}
