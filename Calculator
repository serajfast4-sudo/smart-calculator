<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#050508">
    <title>Smart Calculator</title>
    <style>
        :root {
            --glass: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text: rgba(255, 255, 255, 0.92);
            --muted: rgba(255, 255, 255, 0.28);
            --accent: rgba(255, 255, 255, 0.55);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, 'SF Pro Display', system-ui, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background:
                radial-gradient(ellipse at 30% 20%, rgba(99, 102, 241, 0.12) 0%, transparent 60%),
                radial-gradient(ellipse at 75% 75%, rgba(52, 211, 153, 0.07) 0%, transparent 55%),
                radial-gradient(ellipse at 10% 80%, rgba(168, 85, 247, 0.08) 0%, transparent 50%),
                #050508;
            background-attachment: fixed;
            color: var(--text);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .calc-app {
            width: 100vw;
            height: 100vh;
            max-width: 480px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 32px;
        }

        .hist-toggle {
            background: rgba(255, 255, 255, 0.06);
            border: 0.5px solid rgba(255, 255, 255, 0.1);
            color: var(--muted);
            padding: 5px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 400;
            letter-spacing: 0.02em;
            cursor: pointer;
            box-shadow: inset 0 0.5px 0 rgba(255,255,255,0.12);
        }

        .screen {
            background: rgba(20, 20, 35, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 20px 22px 16px;
            border: 0.5px solid rgba(255, 255, 255, 0.1);
            box-shadow:
                inset 0 0.5px 0 rgba(255,255,255,0.12),
                0 20px 40px rgba(0,0,0,0.4);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            height: 118px;
        }

        .expr {
            color: var(--muted);
            font-size: 0.9rem;
            font-weight: 300;
            text-align: right;
            min-height: 1.2rem;
            letter-spacing: 0.03em;
        }

        .output {
            color: var(--text);
            font-size: 2.8rem;
            font-weight: 200;
            letter-spacing: -0.03em;
            text-align: right;
            overflow-x: auto;
            white-space: nowrap;
        }

        .keypad {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 7px;
            flex: 1;
        }

        button {
            position: relative;
            overflow: hidden;
            border: 0.5px solid rgba(255, 255, 255, 0.08);
            outline: none;
            font-size: 0.98rem;
            font-weight: 300;
            letter-spacing: 0.01em;
            border-radius: 18px;
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
            touch-action: manipulation;
            box-shadow:
                inset 0 0.5px 0 rgba(255,255,255,0.12),
                inset 0 -0.5px 0 rgba(0,0,0,0.25),
                0 2px 6px rgba(0,0,0,0.3);
            transition: transform 0.08s ease, filter 0.08s ease;
        }

        button::before {
            content: "";
            position: absolute;
            top: 0; left: 8%; right: 8%;
            height: 0.5px;
            background: rgba(255, 255, 255, 0.3);
            pointer-events: none;
        }

        button:active {
            transform: scale(0.94);
            filter: brightness(0.72);
        }

        .b-num   { background: rgba(255, 255, 255, 0.05); }
        .b-op    { background: rgba(255, 255, 255, 0.09); }
        .b-sci   { background: rgba(255, 255, 255, 0.03); color: var(--accent); font-size: 0.82rem; }
        .b-clear { background: rgba(180, 40, 40, 0.35); }
        .b-eq    {
            background: rgba(30, 120, 80, 0.4);
            grid-column: span 2;
            font-size: 1.3rem;
            font-weight: 300;
        }

        .drawer {
            position: fixed;
            top: 0; right: -100%;
            width: 80%; max-width: 320px; height: 100%;
            background: rgba(8, 8, 12, 0.92);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-left: 0.5px solid rgba(255, 255, 255, 0.08);
            box-shadow: -20px 0 60px rgba(0,0,0,0.6);
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 10;
            padding: 28px 20px;
            display: flex;
            flex-direction: column;
        }

        .drawer.open { right: 0; }

        .drawer-list {
            list-style: none;
            overflow-y: auto;
            flex: 1;
            margin: 15px 0;
        }

        .drawer-item {
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 0.5px solid rgba(255, 255, 255, 0.07);
            border-radius: 14px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>

<div class="calc-app">
    <div class="top-bar">
        <button class="hist-toggle" onclick="toggleDrawer()">🕒 History</button>
    </div>

    <div class="screen">
        <div class="expr" id="expr"></div>
        <div class="output" id="out">0</div>
    </div>

    <div class="keypad">
        <button class="b-sci" onclick="addFn('sin')">sin</button>
        <button class="b-sci" onclick="addFn('cos')">cos</button>
        <button class="b-sci" onclick="addFn('tan')">tan</button>
        <button class="b-clear" onclick="clearAll()">AC</button>
        <button class="b-clear" onclick="del()">DEL</button>

        <button class="b-sci" onclick="addFn('asin')">asin</button>
        <button class="b-sci" onclick="addFn('acos')">acos</button>
        <button class="b-sci" onclick="addFn('atan')">atan</button>
        <button class="b-sci" onclick="add('(')">(</button>
        <button class="b-sci" onclick="add(')')">)</button>

        <button class="b-sci" onclick="addFn('log')">log</button>
        <button class="b-sci" onclick="addFn('ln')">ln</button>
        <button class="b-sci" onclick="addFn('sqrt')">√</button>
        <button class="b-sci" onclick="add('^')">x^y</button>
        <button class="b-op" onclick="add('/')">÷</button>

        <button class="b-num" onclick="add('7')">7</button>
        <button class="b-num" onclick="add('8')">8</button>
        <button class="b-num" onclick="add('9')">9</button>
        <button class="b-sci" onclick="add('%')">%</button>
        <button class="b-op" onclick="add('*')">×</button>

        <button class="b-num" onclick="add('4')">4</button>
        <button class="b-num" onclick="add('5')">5</button>
        <button class="b-num" onclick="add('6')">6</button>
        <button class="b-sci" onclick="addConst('pi')">π</button>
        <button class="b-op" onclick="add('-')">-</button>

        <button class="b-num" onclick="add('1')">1</button>
        <button class="b-num" onclick="add('2')">2</button>
        <button class="b-num" onclick="add('3')">3</button>
        <button class="b-sci" onclick="addConst('e')">e</button>
        <button class="b-op" onclick="add('+')">+</button>

        <button class="b-num" onclick="add('0')">0</button>
        <button class="b-num" onclick="add('.')">.</button>
        <button class="b-sci" onclick="add('!')">x!</button>
        <button class="b-eq" onclick="calc()">=</button>
    </div>
</div>

<div class="drawer" id="drawer">
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <span style="color:var(--accent); font-weight:400; letter-spacing:0.05em; font-size:0.85rem; text-transform:uppercase;">History</span>
        <button onclick="clearHist()" style="background:none; border:none; color:rgba(180,40,40,0.8); font-size:0.85rem;">Clear</button>
    </div>
    <ul class="drawer-list" id="hist-list"></ul>
    <button style="background:rgba(255,255,255,0.05); border:0.5px solid rgba(255,255,255,0.08); padding:12px; border-radius:14px; font-size:0.9rem;" onclick="toggleDrawer()">Close</button>
</div>

<script>
    let current = '', exprText = '', reset = false;

    const outEl = document.getElementById('out');
    const exprEl = document.getElementById('expr');
    const histEl = document.getElementById('hist-list');

    function toggleDrawer() { document.getElementById('drawer').classList.toggle('open'); }

    function add(val) {
        if (reset) { current = ''; reset = false; }
        current += val;
        render();
    }

    function addFn(fn) {
        if (reset) reset = false;
        current += fn + '(';
        render();
    }

    function addConst(c) {
        if (reset) { current = ''; reset = false; }
        current += c === 'pi' ? 'Math.PI' : 'Math.E';
        render();
    }

    function clearAll() { current = ''; exprText = ''; render(); }
    function del() { if (!reset) { current = current.slice(0, -1); render(); } }

    function render() {
        outEl.textContent = current
            .replace(/Math\.PI/g, 'π')
            .replace(/Math\.E/g, 'e')
            .replace(/\*/g, '×')
            .replace(/\//g, '÷') || '0';
        exprEl.textContent = exprText;
    }

    function factorial(n) {
        if (n < 0) return NaN;
        if (n <= 1) return 1;
        let r = 1; for (let i = 2; i <= n; i++) r *= i;
        return r;
    }

    function parseMath(str) {
        let p = str
            .replace(/sin\(/g, 'Math.sin(')
            .replace(/cos\(/g, 'Math.cos(')
            .replace(/tan\(/g, 'Math.tan(')
            .replace(/asin\(/g, 'Math.asin(')
            .replace(/acos\(/g, 'Math.acos(')
            .replace(/atan\(/g, 'Math.atan(')
            .replace(/log\(/g, 'Math.log10(')
            .replace(/ln\(/g, 'Math.log(')
            .replace(/sqrt\(/g, 'Math.sqrt(')
            .replace(/\^/g, '**')
            .replace(/(\d+)%/g, '($1/100)');
        return p.replace(/(\d+)!/g, (_, n) => factorial(parseInt(n)));
    }

    function calc() {
        if (!current) return;
        try {
            exprText = current.replace(/Math\.PI/g, 'π').replace(/Math\.E/g, 'e');
            let res = eval(parseMath(current));
            if (typeof res === 'number' && !isNaN(res)) {
                res = Number(res.toFixed(8));
                saveHist(exprText, res);
                current = res.toString();
                outEl.textContent = res;
                exprEl.textContent = exprText + ' =';
                reset = true;
            } else { outEl.textContent = 'Error'; }
        } catch { outEl.textContent = 'Error'; }
    }

    function saveHist(e, v) {
        const li = document.createElement('li');
        li.className = 'drawer-item';
        li.innerHTML = `<div style="color:var(--muted); font-size:0.78rem; margin-bottom:2px;">${e}</div><div style="color:var(--text); font-weight:200; font-size:1.1rem;">${v}</div>`;
        li.onclick = () => { current = v.toString(); reset = false; render(); toggleDrawer(); };
        histEl.prepend(li);
    }

    function clearHist() { histEl.innerHTML = ''; }
</script>
</body>
</html>
