</div>

<script>
// ══════════ CALC ══════════
let current='',exprText='',resetOnNext=false,isDeg=true;
const outEl=document.getElementById('out'),exprEl=document.getElementById('expr');
function tap(){if(navigator.vibrate)navigator.vibrate(8);}
function toggleDeg(){isDeg=!isDeg;document.getElementById('deg-btn').textContent=isDeg?'DEG':'RAD';updateTrigFns();}
function updateTrigFns(){const d=isDeg?Math.PI/180:1,r=isDeg?180/Math.PI:1;window.__sin=x=>Math.sin(x*d);window.__cos=x=>Math.cos(x*d);window.__tan=x=>Math.tan(x*d);window.__asin=x=>Math.asin(x)*r;window.__acos=x=>Math.acos(x)*r;window.__atan=x=>Math.atan(x)*r;}
updateTrigFns();
function add(val){if(resetOnNext){if(['+','-','*','/'].includes(val))resetOnNext=false;else{current='';resetOnNext=false;}}current+=val;render();}
function addFn(fn){if(resetOnNext)resetOnNext=false;current+=fn+'(';render();}
function addConst(c){if(resetOnNext){current='';resetOnNext=false;}current+=c==='pi'?'Math.PI':'Math.E';render();}
function clearAll(){current='';exprText='';render();}
function del(){if(resetOnNext){current='';resetOnNext=false;render();return;}current=current.slice(0,-1);render();}
function render(){outEl.textContent=current.replace(/Math\.PI/g,'π').replace(/Math\.E/g,'e').replace(/\*/g,'×').replace(/\//g,'÷')||'0';exprEl.textContent=exprText;}
function copyResult(){const v=outEl.textContent;if(v==='0'||v==='Error')return;tap();tap();if(navigator.clipboard)navigator.clipboard.writeText(v);outEl.classList.add('flashing');setTimeout(()=>outEl.classList.remove('flashing'),250);}
function factorial(n){if(n<0||!Number.isInteger(n))return NaN;if(n<=1)return 1;let r=1;for(let i=2;i<=n;i++)r*=i;return r;}
function parseMath(str){let p=str.replace(/asin\(/g,'__asin(').replace(/acos\(/g,'__acos(').replace(/atan\(/g,'__atan(').replace(/sin\(/g,'__sin(').replace(/cos\(/g,'__cos(').replace(/tan\(/g,'__tan(').replace(/log\(/g,'Math.log10(').replace(/ln\(/g,'Math.log(').replace(/sqrt\(/g,'Math.sqrt(').replace(/\^/g,'**').replace(/(\d+(?:\.\d+)?)%/g,'($1/100)');return p.replace(/(\d+)!/g,(_,n)=>factorial(parseInt(n)));}
function calc(){if(!current)return;try{exprText=current.replace(/Math\.PI/g,'π').replace(/Math\.E/g,'e');let res=eval(parseMath(current));if(typeof res==='number'&&isFinite(res)&&!isNaN(res)){res=parseFloat(res.toFixed(10));saveTape(exprText,res);current=res.toString();outEl.textContent=res;exprEl.textContent=exprText+' =';resetOnNext=true;}else outEl.textContent='Error';}catch{outEl.textContent='Error';}}

// ══════════ TAPE ══════════
const tapeListEl=document.getElementById('tape-list');
function toggleTape(){document.getElementById('tape').classList.toggle('open');}
function saveTape(expr,val){const d=document.createElement('div');d.className='tape-entry';d.innerHTML=`<div class="tape-expr">${expr}</div><div class="tape-val">= ${val}</div>`;d.onclick=()=>{current=val.toString();resetOnNext=false;render();toggleTape();};tapeListEl.prepend(d);}
function clearTape(){tapeListEl.innerHTML='';}

// ══════════ TABS ══════════
let phyInited=false,convInited=false,moneyInited=false,simInited=false;
function switchTab(name){
    tap();
    ['calc','graph','convert','money','physics'].forEach(t=>{
        document.getElementById('panel-'+t).classList.toggle('hidden',t!==name);
        document.getElementById('tab-'+t).classList.toggle('active',t===name);
    });
    if(name==='graph')requestAnimationFrame(initGraph);
    if(name==='convert'&&!convInited){convInited=true;initConvert();}
    if(name==='money'&&!moneyInited){moneyInited=true;initMoney();}
    if(name==='physics'&&!phyInited){phyInited=true;initPhysics();}
}

// ══════════ PHYSICS SUB-TABS ══════════
function switchPhySub(name){
    tap();
    document.getElementById('psub-formulas').classList.toggle('active',name==='formulas');
    document.getElementById('psub-sim').classList.toggle('active',name==='sim');
    document.getElementById('phy-formulas-section').style.display=name==='formulas'?'flex':'none';
    document.getElementById('phy-sim-section').style.display=name==='sim'?'flex':'none';
    if(name==='sim'){if(!simInited){simInited=true;initSim();}else{selectScene(simScene);}}
    else stopSimLoop();
}

// ══════════ GRAPH ══════════
let gCanvas,gCtx,gWrap,gScale=50,gPanX=0,gPanY=0,gFn=null,gInited=false,gDragging=false,gLastX=0,gLastY=0;
function initGraph(){gWrap=document.getElementById('canvas-wrap');gCanvas=document.getElementById('graph-canvas');gCanvas.width=gWrap.offsetWidth;gCanvas.height=gWrap.offsetHeight;gCtx=gCanvas.getContext('2d');if(!gInited){gInited=true;gCanvas.addEventListener('touchstart',e=>{gDragging=true;gLastX=e.touches[0].clientX;gLastY=e.touches[0].clientY;},{passive:true});gCanvas.addEventListener('touchmove',e=>{if(!gDragging)return;gPanX+=e.touches[0].clientX-gLastX;gPanY+=e.touches[0].clientY-gLastY;gLastX=e.touches[0].clientX;gLastY=e.touches[0].clientY;drawGraph();},{passive:true});gCanvas.addEventListener('touchend',()=>gDragging=false,{passive:true});}plotGraph();}
function compileGraphFn(str){let e=str.replace(/asin\(/g,'Math.asin(').replace(/acos\(/g,'Math.acos(').replace(/atan\(/g,'Math.atan(').replace(/sin\(/g,'Math.sin(').replace(/cos\(/g,'Math.cos(').replace(/tan\(/g,'Math.tan(').replace(/log\(/g,'Math.log10(').replace(/ln\(/g,'Math.log(').replace(/sqrt\(/g,'Math.sqrt(').replace(/abs\(/g,'Math.abs(').replace(/\^/g,'**').replace(/\bpi\b/gi,'Math.PI').replace(/\be\b/g,'Math.E');return new Function('x',`"use strict";try{return(${e});}catch(_){return NaN;}`);}
function plotGraph(){const s=document.getElementById('fn-input').value.trim();if(!s)return;try{gFn=compileGraphFn(s);}catch{return;}drawGraph();}
function drawGraph(){if(!gCanvas||!gCtx)return;const W=gCanvas.width,H=gCanvas.height,ctx=gCtx,ox=W/2+gPanX,oy=H/2+gPanY;ctx.clearRect(0,0,W,H);ctx.lineWidth=1;ctx.strokeStyle='rgba(255,255,255,0.04)';for(let x=ox%gScale;x<W;x+=gScale){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}for(let y=oy%gScale;y<H;y+=gScale){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,oy);ctx.lineTo(W,oy);ctx.stroke();ctx.beginPath();ctx.moveTo(ox,0);ctx.lineTo(ox,H);ctx.stroke();if(!gFn)return;ctx.strokeStyle='#38bdf8';ctx.lineWidth=2;ctx.lineJoin='round';ctx.beginPath();let started=false,prevPy=null;for(let px=0;px<=W;px++){const x=(px-ox)/gScale,y=gFn(x);if(!isFinite(y)||Math.abs(y)>1e6){started=false;continue;}const py=oy-y*gScale;if(!started||(prevPy!==null&&Math.abs(py-prevPy)>H)){ctx.moveTo(px,py);started=true;}else ctx.lineTo(px,py);prevPy=py;}ctx.stroke();}
function zoomGraph(f){gScale=Math.max(8,Math.min(250,gScale*f));drawGraph();}
function resetGraph(){gScale=50;gPanX=0;gPanY=0;drawGraph();}

// ══════════ CONVERT ══════════
const unitMaps={Length:{mm:0.001,cm:0.01,m:1,km:1000,in:0.0254,ft:0.3048,yd:0.9144,mi:1609.344},Weight:{mg:0.000001,g:0.001,kg:1,oz:0.0283495,lb:0.453592,t:1000},Data:{B:1,KB:1024,MB:1048576,GB:1073741824,TB:1099511627776},Speed:{'km/h':1,mph:1.60934,'m/s':3.6,kn:1.852},Area:{'cm²':0.0001,'m²':1,'km²':1e6,'ft²':0.092903,ac:4046.86,ha:10000}};
let currentCat='Length';
function initConvert(){const bar=document.getElementById('cat-bar');[...Object.keys(unitMaps),'Temp'].forEach(cat=>{const b=document.createElement('button');b.className='cat-btn'+(cat===currentCat?' active':'');b.textContent=cat;b.onclick=()=>{tap();selectCat(cat);};bar.appendChild(b);});populateUnits();doConvert();}
function selectCat(cat){currentCat=cat;document.querySelectorAll('.cat-btn').forEach(b=>b.classList.toggle('active',b.textContent===cat));populateUnits();doConvert();}
function populateUnits(){const from=document.getElementById('from-unit'),to=document.getElementById('to-unit');from.innerHTML=to.innerHTML='';const list=currentCat==='Temp'?['°C','°F','K']:Object.keys(unitMaps[currentCat]);list.forEach((u,i)=>{from.innerHTML+=`<option value="${u}">${u}</option>`;to.innerHTML+=`<option value="${u}"${i===1?' selected':''}>${u}</option>`;});}
function tempConvert(v,f,t){let c=f==='°C'?v:f==='°F'?(v-32)*5/9:v-273.15;return t==='°C'?c:t==='°F'?c*9/5+32:c+273.15;}
function doConvert(){const v=parseFloat(document.getElementById('conv-in').value),f=document.getElementById('from-unit').value,t=document.getElementById('to-unit').value;if(isNaN(v)){document.getElementById('conv-out').value='';document.getElementById('conv-label').textContent='—';return;}const res=currentCat==='Temp'?tempConvert(v,f,t):v*unitMaps[currentCat][f]/unitMaps[currentCat][t];const rounded=parseFloat(res.toFixed(8));document.getElementById('conv-out').value=rounded;document.getElementById('conv-label').textContent=`${v} ${f} = ${rounded} ${t}`;}
function doConvertReverse(){const v=parseFloat(document.getElementById('conv-out').value),f=document.getElementById('to-unit').value,t=document.getElementById('from-unit').value;if(isNaN(v)){document.getElementById('conv-in').value='';return;}const res=currentCat==='Temp'?tempConvert(v,f,t):v*unitMaps[currentCat][f]/unitMaps[currentCat][t];document.getElementById('conv-in').value=parseFloat(res.toFixed(8));}
function swapUnits(){const f=document.getElementById('from-unit'),t=document.getElementById('to-unit');[f.value,t.value]=[t.value,f.value];doConvert();}

// ══════════ MONEY ══════════
let expenses=[];
function initMoney(){try{const saved=localStorage.getItem('smartcalc_money');if(saved){const d=JSON.parse(saved);document.getElementById('income-amt').value=d.amount||'';document.getElementById('income-freq').value=d.freq||'week';document.getElementById('pay-day').value=d.day||'Thursday';expenses=d.expenses||[];}}catch(e){}onFreqChange();renderExpenses();updateMoney();}
function saveMoney(){try{localStorage.setItem('smartcalc_money',JSON.stringify({amount:document.getElementById('income-amt').value,freq:document.getElementById('income-freq').value,day:document.getElementById('pay-day').value,expenses}));}catch(e){}}
function onFreqChange(){const freq=document.getElementById('income-freq').value;document.getElementById('day-row').style.display=(freq==='week'||freq==='biweek')?'flex':'none';updateMoney();}
function toMonthly(a,f){const m={hour:a*8*22,day:a*22,week:a*52/12,biweek:a*26/12,month:a,year:a/12};return m[f]||0;}
function toDaily(a,f){const m={hour:a*8,day:a,week:a/5,biweek:a/10,month:a/22,year:a/260};return m[f]||0;}
function toWeekly(a,f){const m={hour:a*40,day:a*5,week:a,biweek:a/2,month:a*12/52,year:a/52};return m[f]||0;}
function fmt(n){if(!n||isNaN(n))return'$0';return'$'+n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
function getNextPayday(dayName){const days=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];const target=days.indexOf(dayName);if(target===-1)return'';const today=new Date(),todayDay=today.getDay();let diff=target-todayDay;if(diff<=0)diff+=7;const next=new Date(today);next.setDate(today.getDate()+diff);return`Next ${dayName}: ${next.toLocaleDateString('en-US',{weekday:'long',month:'short',day:'numeric'})} · ${diff} day${diff!==1?'s':''} away`;}
function updateMoney(){const amount=parseFloat(document.getElementById('income-amt').value)||0,freq=document.getElementById('income-freq').value,day=document.getElementById('pay-day').value;const monthly=toMonthly(amount,freq),weekly=toWeekly(amount,freq),daily=toDaily(amount,freq);document.getElementById('daily-inc').textContent=fmt(daily);document.getElementById('weekly-inc').textContent=fmt(weekly);document.getElementById('monthly-inc').textContent=fmt(monthly);const badge=document.getElementById('payday-badge');if((freq==='week'||freq==='biweek')&&amount>0){badge.textContent=getNextPayday(day);badge.style.display='block';}else badge.style.display='none';const totalSpent=expenses.reduce((a,e)=>a+e.amt,0),remaining=monthly-totalSpent;document.getElementById('sum-earn').textContent=fmt(monthly);document.getElementById('sum-earn-sub').textContent=(freq==='week'||freq==='biweek')?`every ${day}`:`/ ${freq}`;document.getElementById('sum-spent').textContent=fmt(totalSpent);document.getElementById('sum-spent-sub').textContent=`${expenses.length} item${expenses.length!==1?'s':''}`;document.getElementById('sum-saved').textContent=fmt(remaining);document.getElementById('sum-saved-sub').textContent=remaining>=0?"you're in the green 💚":"over budget 🔴";saveMoney();}
function addExpense(){const name=document.getElementById('exp-name').value.trim(),amt=parseFloat(document.getElementById('exp-amt').value);if(!name||isNaN(amt)||amt<=0)return;expenses.push({id:Date.now(),name,amt});document.getElementById('exp-name').value='';document.getElementById('exp-amt').value='';renderExpenses();updateMoney();}
function deleteExpense(id){tap();expenses=expenses.filter(e=>e.id!==id);renderExpenses();updateMoney();}
